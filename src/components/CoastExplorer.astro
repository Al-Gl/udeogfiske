---
// "Kystverden": a full-screen, zoomable coast picture with pins and spot buttons.
// Picking a spot glides the camera to it; spots with a `scene` then crossfade to a close-up that settles
// from slightly enlarged to normal. "Tilbage" plays it in reverse. Data: src/data/coast-world.json.
// Leaflet (CRS.Simple) treats the overview picture as a flat map, so pins are placed in % of the picture.
import 'leaflet/dist/leaflet.css';
import world from '../data/coast-world.json';
---

<section class="ke" data-world={JSON.stringify(world)}>
  <div class="ke-map" role="region" aria-label="Interaktivt billede af kysten"></div>
  <img class="ke-scene" alt="" aria-hidden="true" />
  <div class="ke-spins"></div>

  <button class="ke-back" type="button" hidden>← Tilbage til oversigt</button>

  <aside class="ke-card is-open" aria-live="polite">
    <button class="ke-close" type="button" aria-label="Luk">×</button>
    <button class="ke-up" type="button" hidden></button>
    <p class="ke-kicker">Kystverden</p>
    <h2 class="ke-title">{world.root.title}</h2>
    <p class="ke-text">{world.root.text}</p>
    <div class="ke-items" hidden>
      <h3>I billedet</h3>
      <ul class="ke-itemlist"></ul>
    </div>
    <div class="ke-extra" hidden>
      <h3>Det lever her</h3>
      <ul class="ke-prey"></ul>
      <h3>Hvornår</h3>
      <p class="ke-when"></p>
    </div>
  </aside>

  <nav class="ke-bar" aria-label="Vælg et sted på kysten">
    {world.hotspots.map((h) => (
      <button type="button" data-id={h.id} class={h.scene ? 'is-major' : ''}>{h.title}</button>
    ))}
  </nav>
</section>

<script>
  // @ts-nocheck — small untyped DOM/Leaflet glue; Leaflet ships no types.
  import L from 'leaflet';

  const root = document.querySelector<HTMLElement>('.ke');
  if (root) {
    const world = JSON.parse(root.dataset.world!);
    const W = world.root.w, H = world.root.h;
    const $ = (s) => root.querySelector(s);
    const scene = $('.ke-scene') as HTMLImageElement;
    const back = $('.ke-back') as HTMLButtonElement;
    const card = $('.ke-card') as HTMLElement;
    const extra = $('.ke-extra') as HTMLElement;
    const barButtons = [...root.querySelectorAll<HTMLButtonElement>('.ke-bar button')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms) => new Promise((r) => setTimeout(r, still ? 0 : ms));

    const bounds = L.latLngBounds([0, 0], [H, W]);
    const toLatLng = (h) => L.latLng(H * (1 - h.y / 100), W * (h.x / 100));

    const map = L.map($('.ke-map'), {
      // The mouse wheel scrolls the page (to the article below); zoom with +/−, double-click or pinch.
      crs: L.CRS.Simple, zoomSnap: 0, zoomDelta: 0.5, attributionControl: false, scrollWheelZoom: false,
      maxBounds: bounds, maxBoundsViscosity: 1,
    });
    L.imageOverlay(world.root.image, bounds, { alt: world.root.title }).addTo(map);

    // "Cover" zoom: the smallest zoom where the picture fills the whole screen.
    let cover = 0;
    const fitCover = (keepView) => {
      const size = map.getSize();
      cover = Math.log2(Math.max(size.x / W, size.y / H));
      map.setMinZoom(cover);
      map.setMaxZoom(cover + 2.5);
      if (!keepView || map.getZoom() < cover) map.setView(bounds.getCenter(), cover, { animate: false });
    };
    fitCover(false);
    map.on('resize', () => fitCover(true));

    // Keep a target view inside the picture, so the camera never glides past an edge and jumps back.
    const clamp = (ll, z) => {
      const size = map.getSize(), k = Math.pow(2, z);
      const hw = size.x / 2 / k, hh = size.y / 2 / k;
      return L.latLng(Math.min(Math.max(ll.lat, hh), H - hh), Math.min(Math.max(ll.lng, hw), W - hw));
    };
    const glide = (ll, z, duration) => new Promise<void>((done) => {
      const target = clamp(ll, z);
      if (still) { map.setView(target, z, { animate: false }); return done(); }
      map.once('moveend', () => done());
      map.flyTo(target, z, { duration, easeLinearity: 0.15 });
    });

    // Pins
    const pins = L.layerGroup().addTo(map);
    for (const h of world.hotspots) {
      const icon = L.divIcon({
        className: 'ke-pin' + (h.scene ? ' ke-pin-major' : ''),
        html: '<span class="ke-pulse"></span><span class="ke-dot"></span><span class="ke-label">' + h.title + '</span>',
        iconSize: [24, 24],
      });
      L.marker(toLatLng(h), { icon, title: h.title, alt: h.title, keyboard: true }).on('click', () => open(h)).addTo(pins);
    }

    // Info card
    const spins = $('.ke-spins') as HTMLElement;
    const up = $('.ke-up') as HTMLButtonElement;
    const items = $('.ke-items') as HTMLElement;
    const markItem = (id) => {
      for (const b of root.querySelectorAll('.ke-spin, .ke-itemlist button')) b.classList.toggle('is-active', b.dataset.id === id);
    };
    const showCard = (h) => {
      $('.ke-title').textContent = h ? h.title : world.root.title;
      $('.ke-text').textContent = h ? h.text : world.root.text;
      extra.hidden = !h;
      up.hidden = true;
      const list = h && h.scene && h.scene.pins;
      items.hidden = !list;
      if (h) {
        const prey = $('.ke-prey');
        prey.innerHTML = '';
        for (const p of h.prey) { const li = document.createElement('li'); li.textContent = p; prey.append(li); }
        $('.ke-when').textContent = h.when;
      }
      if (list) {
        const ul = $('.ke-itemlist');
        ul.innerHTML = '';
        for (const p of list) {
          const b = document.createElement('button');
          b.type = 'button'; b.textContent = p.title; b.dataset.id = p.id;
          b.addEventListener('click', () => showItem(h, p));
          const li = document.createElement('li'); li.append(b); ul.append(li);
        }
      }
      markItem(null);
      card.classList.add('is-open');
      barButtons.forEach((b) => b.classList.toggle('is-active', !!h && b.dataset.id === h.id));
    };
    // One thing inside a close-up (plant, fish, stone…): its own text, with a link back to the spot.
    const showItem = (h, p) => {
      $('.ke-title').textContent = p.title;
      $('.ke-text').textContent = p.text;
      extra.hidden = true;
      up.textContent = '← ' + h.title;
      up.onclick = () => showCard(h);
      up.hidden = false;
      markItem(p.id);
      card.classList.add('is-open');
    };
    $('.ke-close').addEventListener('click', () => card.classList.remove('is-open'));

    // Close-up on top of the map: fades in while it settles from 1.12× to 1×.
    let inScene = null;
    const narrow = () => matchMedia('(max-width: 700px)').matches;
    // Place the close-up's pins on the picture as it is cropped ("cover" + focus), so they sit on the right thing.
    const placeSpins = () => {
      if (!inScene) return;
      const s = inScene.scene, cw = root.clientWidth, ch = root.clientHeight;
      const k = Math.max(cw / s.w, ch / s.h), rw = s.w * k, rh = s.h * k;
      const [fx, fy] = (s.focus || '50% 50%').split(' ').map(parseFloat);
      const ox = (cw - rw) * fx / 100, oy = (ch - rh) * fy / 100;
      for (const b of spins.children) {
        const x = ox + rw * b.dataset.x / 100, y = oy + rh * b.dataset.y / 100;
        b.style.left = x + 'px'; b.style.top = y + 'px';
        b.hidden = x < 16 || x > cw - 16 || y < 16 || y > ch - 16; // cropped away (phones): use the card's buttons
      }
    };
    window.addEventListener('resize', placeSpins);
    const showScene = async (h) => {
      scene.src = h.scene.image;
      scene.alt = h.title;
      scene.style.objectPosition = h.scene.focus || 'center';
      card.classList.toggle('is-left', !!h.scene.cardLeft);
      spins.innerHTML = '';
      for (const p of h.scene.pins || []) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'ke-pin ke-spin';
        b.dataset.x = p.x; b.dataset.y = p.y; b.dataset.id = p.id;
        b.setAttribute('aria-label', p.title);
        b.innerHTML = '<span class="ke-pulse"></span><span class="ke-dot"></span><span class="ke-label"></span>';
        b.querySelector('.ke-label').textContent = p.title;
        b.addEventListener('click', () => showItem(h, p));
        spins.append(b);
      }
      await scene.decode().catch(() => {});
      inScene = h;
      placeSpins();
      root.classList.add('in-scene');
      back.hidden = false;
      if (narrow()) card.classList.remove('is-open'); // phones: let the picture speak; tap the button again for the text
    };
    const hideScene = async () => {
      if (!inScene) return;
      root.classList.remove('in-scene');
      back.hidden = true;
      inScene = null;
      card.classList.remove('is-left');
      await wait(500);
    };

    let busy = false;
    async function open(h) {
      if (busy) return;
      if (inScene === h) return showCard(h); // already there: just bring the text back
      busy = true;
      showCard(h);
      await hideScene();
      if (h.scene) {
        await glide(toLatLng(h), cover + 1.8, 1.5);
        await showScene(h);
        back.focus();
      } else {
        await glide(toLatLng(h), cover + 0.8, 1.2);
      }
      busy = false;
    }

    async function overview() {
      if (busy) return;
      busy = true;
      showCard(null);
      await hideScene();
      await glide(bounds.getCenter(), cover, 1.3);
      busy = false;
    }

    back.addEventListener('click', overview);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && inScene) overview(); });
    barButtons.forEach((b) => b.addEventListener('click', () => open(world.hotspots.find((x) => x.id === b.dataset.id))));

    // Fetch the close-ups once the overview is up, so the crossfade never waits on the network.
    setTimeout(() => world.hotspots.forEach((h) => { if (h.scene) new Image().src = h.scene.image; }), 1500);
  }
</script>

<style>
  .ke {
    position: sticky; /* stays put while the article below slides up over it */
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #0d4a5e;
  }
  .ke-map { position: absolute; inset: 0; background: #0d4a5e; }

  .ke-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.12);
    transition: opacity 0.8s ease, transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
    z-index: 500;
  }
  .ke.in-scene .ke-scene { opacity: 1; transform: scale(1); pointer-events: auto; }
  .ke.in-scene .ke-map :global(.ke-pin) { opacity: 0; pointer-events: none; }

  /* Leaflet's +/− buttons: below the top bar, only on the overview */
  .ke :global(.leaflet-top.leaflet-left) { top: 4.25rem; }
  .ke.in-scene :global(.leaflet-control-zoom) { display: none; }

  /* Pins inside a close-up: fade in once the picture has settled */
  .ke-spins { position: absolute; inset: 0; z-index: 600; pointer-events: none; opacity: 0; transition: opacity 0.4s; }
  .ke.in-scene .ke-spins { opacity: 1; transition: opacity 0.6s 1.2s; }
  .ke.in-scene .ke-spins :global(.ke-spin) { pointer-events: auto; }
  .ke-spins :global(.ke-spin) {
    position: absolute; width: 24px; height: 24px; margin: -12px 0 0 -12px;
    padding: 0; border: 0; background: none; cursor: pointer;
  }
  .ke-spins :global(.ke-spin[hidden]) { display: none; }
  .ke-spins :global(.ke-spin.is-active .ke-dot) { background: #f59e0b; border-color: #fff; }

  .ke-up {
    display: block; margin: 0 2rem 0.5rem 0; padding: 0; border: 0; background: none;
    color: #0d4a5e; font-weight: 700; font-size: 0.85rem; cursor: pointer;
  }
  .ke-up[hidden] { display: none; }
  .ke-up:hover { text-decoration: underline; }
  .ke-items h3 {
    font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: #6b7280; margin: 1.1rem 0 0.4rem;
  }
  .ke-itemlist { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }
  .ke-itemlist :global(button) {
    padding: 0.3rem 0.75rem; border: 1px solid #0d4a5e; border-radius: 999px; background: #fff; color: #0d4a5e;
    font-size: 0.8125rem; font-weight: 600; cursor: pointer;
  }
  .ke-itemlist :global(button:hover) { background: #e6f2f5; }
  .ke-itemlist :global(button.is-active) { background: #0d4a5e; color: #fff; }

  .ke-back {
    position: absolute;
    top: 4.5rem;
    left: 1rem;
    z-index: 1100;
    padding: 0.6rem 1rem;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #0d4a5e;
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    cursor: pointer;
  }
  .ke-back:hover { background: #f0f7f9; }

  /* Info card: panel on the right (desktop), sheet above the button bar (phones) */
  .ke-card {
    position: absolute;
    z-index: 1100;
    top: 4.5rem;
    right: 1rem;
    width: 340px;
    max-height: calc(100% - 10rem);
    overflow-y: auto;
    padding: 1.4rem 1.5rem 1.5rem;
    border-radius: 14px;
    background: rgba(255,255,255,0.96);
    box-shadow: 0 10px 40px rgba(0,0,0,0.25);
    transform: translateX(calc(100% + 2rem));
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ke-card.is-open { transform: none; }
  @media (min-width: 701px) {
    .ke-card.is-left { right: auto; left: 1rem; top: 7.75rem; transform: translateX(calc(-100% - 2rem)); }
    .ke-card.is-left.is-open { transform: none; }
  }
  @media (max-width: 700px) {
    .ke-card {
      top: auto;
      left: 0.75rem;
      right: 0.75rem;
      bottom: 4.75rem;
      width: auto;
      max-height: 45dvh;
      transform: translateY(calc(100% + 6rem));
    }
  }
  .ke-close {
    position: absolute;
    top: 0.6rem;
    right: 0.7rem;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #6b7280;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .ke-close:hover { background: #f0f7f9; color: #111827; }
  .ke-kicker {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: #0d4a5e; margin: 0 0 0.35rem;
  }
  .ke-title { font-size: 1.35rem; font-weight: 700; color: #111827; margin: 0 2rem 0.6rem 0; }
  .ke-text { font-size: 0.9375rem; color: #374151; line-height: 1.7; margin: 0; }
  .ke-extra h3 {
    font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: #6b7280; margin: 1.1rem 0 0.4rem;
  }
  .ke-prey { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }
  .ke-prey :global(li) {
    padding: 0.2rem 0.65rem; border-radius: 999px; background: #e6f2f5; color: #0d4a5e;
    font-size: 0.8125rem; font-weight: 600;
  }
  .ke-when { font-size: 0.9rem; color: #374151; line-height: 1.6; margin: 0; }

  /* Spot buttons along the bottom */
  .ke-bar {
    position: absolute;
    z-index: 1100;
    left: 0;
    right: 0;
    bottom: 1rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  @media (max-width: 900px) { .ke-bar { justify-content: flex-start; } }
  .ke-bar button {
    flex: none;
    padding: 0.65rem 1.1rem;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 999px;
    background: rgba(13,74,94,0.82);
    backdrop-filter: blur(6px);
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .ke-bar button.is-major::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 0.5rem; border-radius: 50%; background: #f59e0b; vertical-align: 1px; }
  .ke-bar button:hover { background: rgba(13,74,94,0.95); }
  .ke-bar button.is-active { background: #fff; color: #0d4a5e; }

  /* Pins (Leaflet divIcons live outside this component's scope, hence :global) */
  :global(.ke-pin) { transition: opacity 0.4s; }
  :global(.ke-pin .ke-dot) {
    position: absolute; inset: 4px; border-radius: 50%;
    background: #fff; border: 3px solid #0d4a5e; box-shadow: 0 2px 6px rgba(0,0,0,0.4);
  }
  :global(.ke-pin-major .ke-dot) { background: #f59e0b; border-color: #fff; }
  :global(.ke-pin .ke-pulse) {
    position: absolute; inset: 0; border-radius: 50%;
    background: rgba(255,255,255,0.7);
    animation: ke-pulse 1.8s ease-out infinite;
  }
  :global(.ke-pin .ke-label) {
    position: absolute; left: 50%; top: 28px; transform: translateX(-50%);
    white-space: nowrap; padding: 0.15rem 0.5rem; border-radius: 6px;
    background: rgba(13,74,94,0.88); color: #fff;
    font: 600 0.75rem/1.4 system-ui, sans-serif; pointer-events: none;
  }
  :global(.ke-pin:focus-visible) { outline: 3px solid #f59e0b; outline-offset: 4px; border-radius: 50%; }
  @keyframes -global-ke-pulse {
    0% { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(2.2); opacity: 0; }
  }
  @media (max-width: 600px) { :global(.ke-pin .ke-label) { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.ke-pin .ke-pulse) { animation: none; }
    .ke-scene, .ke-card { transition: none; }
  }
</style>
