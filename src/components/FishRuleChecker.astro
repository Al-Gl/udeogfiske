---
// "Må jeg tage fisken med hjem?" — checks species + where + date (+ optional length)
// against src/data/fiskeregler.ts. All logic runs in the browser; no data leaves the page.
// Deep links: ?art=havoerred&hvor=kattegat pre-fills the form.
import { SPECIES, ZONES, AREA_NAMES, RULES_SOURCE } from '../data/fiskeregler';

interface Props { species?: string; zone?: string }
const { species = 'havoerred', zone = 'kattegat' } = Astro.props;
const data = { species: SPECIES, zones: ZONES, areas: AREA_NAMES, source: RULES_SOURCE };
const salt = ZONES.filter((z) => z.water === 'salt');
const fresh = ZONES.filter((z) => z.water === 'fersk');
---

<section class="frc" aria-labelledby="frc-title" data-default-species={species} data-default-zone={zone}>
  <h2 id="frc-title" class="frc-title">Tjek din fisk</h2>

  <form class="frc-form" onsubmit="return false">
    <label class="frc-field">
      <span>Art</span>
      <select name="art">
        {SPECIES.map((s) => <option value={s.slug} selected={s.slug === species}>{s.name}</option>)}
      </select>
    </label>
    <label class="frc-field frc-wide">
      <span>Hvor fisker du?</span>
      <select name="hvor">
        <optgroup label="Saltvand">
          {salt.map((z) => <option value={z.key} selected={z.key === zone}>{z.label}</option>)}
        </optgroup>
        <optgroup label="Ferskvand">
          {fresh.map((z) => <option value={z.key} selected={z.key === zone}>{z.label}</option>)}
        </optgroup>
      </select>
    </label>
    <label class="frc-field">
      <span>Dato</span>
      <input type="date" name="dato" />
    </label>
    <label class="frc-field">
      <span>Længde <em>(valgfri)</em></span>
      <input type="number" name="laengde" min="1" max="200" inputmode="numeric" placeholder="cm" />
    </label>
    <fieldset class="frc-field frc-state" hidden>
      <legend>Er fisken blank eller farvet?</legend>
      <label><input type="radio" name="tilstand" value="blank" /> Blank</label>
      <label><input type="radio" name="tilstand" value="farvet" /> Farvet</label>
      <label><input type="radio" name="tilstand" value="" checked /> Ved ikke</label>
    </fieldset>
  </form>

  <div class="frc-result" aria-live="polite">
    <p class="frc-verdict"></p>
    <p class="frc-why"></p>
    <dl class="frc-facts"></dl>
    <ul class="frc-notes"></ul>
  </div>

  <noscript><p class="frc-why">Værktøjet kræver JavaScript. Du kan se alle mindstemål og fredningstider i tabellen længere nede.</p></noscript>

  <p class="frc-src">
    Kilde: <a href={RULES_SOURCE.url} rel="noopener" target="_blank">{RULES_SOURCE.name}</a> ({RULES_SOURCE.law}), tjekket 11. november 2026.
    Svaret er vejledende. Der kan gælde lokale regler, fx fredningsbælter ved å- og bækudløb.
  </p>

  <script type="application/json" class="frc-data" set:html={JSON.stringify(data)}></script>
</section>

<script>
  import { evaluate, mmdd } from '../lib/fishRules';

  document.querySelectorAll<HTMLElement>('.frc').forEach((box) => {
    const data = JSON.parse(box.querySelector('.frc-data')!.textContent!);
    const form = box.querySelector('form')!;
    const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement & HTMLSelectElement;
    const stateBox = box.querySelector<HTMLElement>('.frc-state')!;
    const result = box.querySelector<HTMLElement>('.frc-result')!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

    // Pre-fill from the URL (?art=…&hvor=…) and default the date to today.
    const params = new URLSearchParams(location.search);
    const art = params.get('art'), hvor = params.get('hvor');
    if (art && data.species.some((s: { slug: string }) => s.slug === art)) f('art').value = art;
    if (hvor && data.zones.some((z: { key: string }) => z.key === hvor)) f('hvor').value = hvor;
    const today = new Date();
    f('dato').value = `${today.getFullYear()}-${mmdd(today)}`;

    function render() {
      const r = evaluate(data, {
        art: f('art').value,
        hvor: f('hvor').value,
        date: f('dato').value ? new Date(f('dato').value + 'T12:00:00') : today,
        length: f('laengde').value ? parseFloat(f('laengde').value) : undefined,
        state: (form.querySelector<HTMLInputElement>('input[name="tilstand"]:checked')?.value || '') as '' | 'blank' | 'farvet',
      });
      stateBox.hidden = !r.showState;
      result.dataset.tone = r.tone;
      box.querySelector('.frc-verdict')!.textContent = r.verdict;
      box.querySelector('.frc-why')!.textContent = r.why;
      box.querySelector('.frc-facts')!.innerHTML = r.facts.map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join('');
      box.querySelector('.frc-notes')!.innerHTML = r.notes.map((n) => `<li>${esc(n)}</li>`).join('');
      history.replaceState(null, '', `${location.pathname}?${new URLSearchParams({ art: f('art').value, hvor: f('hvor').value })}${location.hash}`);
    }

    form.addEventListener('input', render);
    form.addEventListener('change', render);
    render();
  });
</script>

<style>
  .frc { border-top: 3px solid #0d4a5e; border-bottom: 1px solid #d6dde2; padding: 1.25rem 0 1.25rem; margin: 0 0 3rem; }
  .frc-title { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #0d4a5e; margin-bottom: 1rem; }

  .frc-form { display: grid; grid-template-columns: 1fr 2fr; gap: 1rem 1.25rem; }
  .frc-field { display: flex; flex-direction: column; gap: 0.35rem; border: 0; padding: 0; margin: 0; min-width: 0; }
  .frc-field > span, .frc-field legend { font-size: 0.8125rem; font-weight: 600; color: #374151; }
  .frc-field em { font-style: normal; font-weight: 400; color: #9ca3af; }
  .frc-field select, .frc-field input[type="date"], .frc-field input[type="number"] {
    font: inherit; font-size: 0.96875rem; color: #111827; background: #ffffff;
    border: 1px solid #c9d2d8; border-radius: 6px; padding: 0.6rem 0.7rem; width: 100%;
  }
  .frc-field select:focus, .frc-field input:focus { outline: 2px solid #0d4a5e; outline-offset: 1px; border-color: #0d4a5e; }
  .frc-state { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; }
  .frc-state legend { width: 100%; margin-bottom: 0.35rem; }
  .frc-state label { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.9375rem; color: #1f2937; cursor: pointer; }
  .frc-state[hidden] { display: none; }

  .frc-result { margin-top: 1.5rem; padding: 0.25rem 0 0.25rem 1.125rem; border-left: 4px solid #9ca3af; }
  .frc-result[data-tone="ok"] { border-left-color: #2f6f3e; }
  .frc-result[data-tone="no"] { border-left-color: #b42318; }
  .frc-result[data-tone="check"] { border-left-color: #b7791f; }
  .frc-verdict { font-size: clamp(1.375rem, 3vw, 1.75rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; color: #111827; }
  .frc-result[data-tone="ok"] .frc-verdict { color: #2f6f3e; }
  .frc-result[data-tone="no"] .frc-verdict { color: #b42318; }
  .frc-result[data-tone="check"] .frc-verdict { color: #8a5a12; }
  .frc-why { font-size: 0.96875rem; color: #374151; line-height: 1.6; margin-top: 0.5rem; }
  .frc-why:empty { display: none; }

  .frc-facts { margin-top: 1rem; }
  .frc-facts div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 0.55rem 0; border-top: 1px solid #e8ecef; }
  .frc-facts dt { font-size: 0.8125rem; font-weight: 600; color: #6b7280; }
  .frc-facts dd { font-size: 0.9375rem; color: #1f2937; }
  .frc-notes { list-style: none; margin-top: 0.75rem; display: grid; gap: 0.5rem; }
  .frc-notes li { font-size: 0.875rem; color: #4b5563; line-height: 1.55; padding-left: 1rem; position: relative; }
  .frc-notes li::before { content: "–"; position: absolute; left: 0; color: #9ca3af; }

  .frc-src { font-size: 0.8125rem; color: #8a949c; line-height: 1.6; margin-top: 1.5rem; }
  .frc-src a { color: #6b7280; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 640px) {
    .frc-form { grid-template-columns: 1fr; }
    .frc-facts div { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
