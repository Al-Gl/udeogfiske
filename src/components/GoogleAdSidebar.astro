<style>
  /* Size lives on the <ins> itself, per Google's "hide responsive ad unit"
     pattern: when the ins is display:none at request time, AdSense skips the
     ad request instead of erroring on a zero-width slot. */
  .gad-ins-side { display: none; }

  @media (min-width: 1580px) {
    .gad-ins-side {
      display: inline-block;
      width: 160px;
      height: 600px;
    }
  }

  .gad-sidebar {
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .gad-sidebar.gad-visible {
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 1580px) {
    .gad-sidebar {
      display: block;
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      width: 160px;
      min-height: 300px;
      z-index: 50;
      background: #f0f4f6;
      border: 1px dashed #9ca3af;
      border-radius: 8px;
    }

    .gad-sidebar--left { left: 20px; }
    .gad-sidebar--right { right: 20px; }
  }

  .gad-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    pointer-events: none;
  }

  /* Once Google has actually rendered an ad, drop the placeholder chrome so
     only the ad itself shows. AdSense stamps data-ad-status on the <ins>. */
  .gad-sidebar:has(ins[data-ad-status="filled"]) {
    background: transparent;
    border-color: transparent;
  }
  .gad-sidebar:has(ins[data-ad-status="filled"]) .gad-placeholder {
    display: none;
  }
</style>
