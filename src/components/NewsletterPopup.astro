---
// Newsletter sign-up: a band above the footer + the pop-up it opens.
// Self-contained: include once in MainLayout (just before <footer>) to cover the whole site.
//
// The form posts straight to the Brevo subscription form (double opt-in is handled by Brevo).
// Open the pop-up anywhere with:  window.uofNewsletter.open()
// Elements with [data-nl-link] are un-hidden when the pop-up is available.
const FORM_ACTION: string = 'https://a52ef3a0.sibforms.com/serve/MUIFADxUAzCnOWCtqk9-6war9eMwgtKKlyhuwA5fbZpBEkKORz3VDYAA84kxswsAzoJlkhzk8tg0wHLqidYXMz6b1RmQXrnfMsR4fEwoVGBqxBNx2VaKC2a_lOP_DmBVOh9c-p2SXl8lUd-8nuWz_ITRYa3ua8mFH6XtqQ0EhoLqS6cpQZANeVf_e5iZ9BTsEL-yhvGJsF8W93CfYA=='; // Brevo form address — empty = not live yet

// Without a form address nothing is rendered in production; in dev it shows as a demo.
const enabled = FORM_ACTION !== '' || import.meta.env.DEV;
---

{enabled && (
  <Fragment>
  <section class="nl-band" aria-labelledby="nl-band-title">
    <div class="nl-band-inner">
      <div>
        <h2 id="nl-band-title" class="nl-band-title">Få månedens fiskeri i indbakken</h2>
        <p class="nl-band-text">Én mail om måneden: månedens plads, hvad der bider lige nu, og ét stykke grej, jeg anbefaler.</p>
      </div>
      <button type="button" class="nl-band-btn" data-nl-open>Tilmeld mig</button>
    </div>
  </section>

  <div class="nl-overlay" id="nl-overlay" data-action={FORM_ACTION}>
    <div class="nl-dialog" role="dialog" aria-modal="true" aria-labelledby="nl-title">
      <button type="button" class="nl-close" data-nl-close aria-label="Luk">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="nl-photo">
        <img src="/images/havørred_hero1.jpeg" alt="Nærbillede af en havørred med et grønt gennemløbsblink i munden" loading="lazy" width="1920" height="1080" />
      </div>

      <div class="nl-content">
        <p class="nl-eyebrow">Nyhedsbrev</p>
        <h2 class="nl-title" id="nl-title">Få månedens fiskeri i indbakken</h2>
        <p class="nl-text">Én mail om måneden, skrevet af mig. Kort, konkret og til at bruge på næste tur.</p>
        <ul class="nl-list">
          <li>Månedens plads med luftfoto og noter</li>
          <li>Hvad der bider lige nu, og hvordan jeg fisker det</li>
          <li>Ét stykke grej, jeg anbefaler</li>
        </ul>

        <form class="nl-form" id="nl-form" method="post" action={FORM_ACTION || '#'}>
          <label class="nl-label" for="nl-email">Din e-mail</label>
          <input class="nl-input" id="nl-email" name="EMAIL" type="email" autocomplete="email" placeholder="Din e-mail" required />
          <input type="text" name="email_address_check" value="" class="nl-label" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="locale" value="en" />
          <button class="nl-submit" type="submit">Tilmeld mig</button>
          <p class="nl-error" role="alert" hidden>Noget gik galt. Prøv igen om lidt.</p>
        </form>

        <p class="nl-done">Tak! Tjek din indbakke og bekræft din tilmelding, så er du med fra næste mail. Kan du ikke finde mailen, så kig i spam-mappen.</p>

        <p class="nl-consent">Ved at tilmelde dig siger du ja til at modtage nyhedsbrevet fra Ude og Fiske på e-mail. Du kan altid afmelde dig igen med ét klik. <a href="/cookiepolitik/#nyhedsbrev">Læs mere</a>.</p>
        <button type="button" class="nl-decline" data-nl-close>Nej tak</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var DELAY_MS = 25000;        // show after 25 seconds …
      var SCROLL_SHARE = 0.5;      // … or once half the page is read
      var SNOOZE_DAYS = 30;        // stay away for 30 days after "Nej tak"
      var KEY = 'uof-nl';

      var overlay = document.getElementById('nl-overlay');
      if (!overlay) return;
      var dialog = overlay.querySelector('.nl-dialog');
      var form = document.getElementById('nl-form');
      var input = document.getElementById('nl-email');
      var error = overlay.querySelector('.nl-error');
      var action = overlay.getAttribute('data-action');
      var shown = false;

      function snoozed() {
        try {
          var v = JSON.parse(localStorage.getItem(KEY) || 'null');
          return !!v && (v.done || Date.now() < v.until);
        } catch (e) { return false; }
      }
      function remember(done) {
        try {
          localStorage.setItem(KEY, JSON.stringify({ done: done, until: Date.now() + SNOOZE_DAYS * 864e5 }));
        } catch (e) {}
      }
      function cookieBannerOpen() {
        var cc = document.getElementById('cc-root');
        return !!cc && !cc.hidden;
      }
      function open(manual) {
        if (!manual && (shown || snoozed() || cookieBannerOpen())) return;
        shown = true;
        overlay.classList.add('is-open');
        if (manual) setTimeout(function () { input.focus(); }, 60);   // after the overlay is visible
      }
      function close() {
        overlay.classList.remove('is-open');
        if (!dialog.classList.contains('is-done')) remember(false);
      }
      function done() {
        dialog.classList.add('is-done');
        remember(true);
      }

      window.uofNewsletter = { open: function () { open(true); } };

      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-nl-open]')) open(true);
        else if (e.target === overlay || e.target.closest('[data-nl-close]')) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) close();
      });
      document.addEventListener('DOMContentLoaded', function () {
        Array.prototype.forEach.call(document.querySelectorAll('[data-nl-link]'), function (el) { el.hidden = false; });
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        error.hidden = true;
        if (!action) { done(); return; }   // dev demo: no form address yet
        fetch(action + (action.indexOf('?') < 0 ? '?' : '&') + 'isAjax=1', { method: 'POST', body: new FormData(form) })
          .then(function (r) { return r.json(); })
          .then(function (d) { if (d && d.success) done(); else error.hidden = false; })
          .catch(function () { error.hidden = false; });
      });

      setTimeout(function () { open(false); }, DELAY_MS);
      window.addEventListener('scroll', function () {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        if (max > 0 && window.scrollY / max >= SCROLL_SHARE) open(false);
      }, { passive: true });
      document.addEventListener('mouseout', function (e) {
        if (!e.relatedTarget && e.clientY <= 0) open(false);   // mouse leaves the page upwards (desktop only)
      });
    })();
  </script>
  </Fragment>
)}

<style>
  /* ── Band above the footer ── */
  .nl-band { background: #0d4a5e; padding: 2.25rem 1.5rem; }
  .nl-band-inner {
    max-width: var(--mw); margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
  }
  .nl-band-title { margin: 0 0 0.375rem; font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; color: #ffffff; }
  .nl-band-text { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: rgba(255, 255, 255, 0.8); }
  .nl-band-btn {
    flex-shrink: 0; padding: 0.9rem 1.6rem;
    font: inherit; font-size: 0.9375rem; font-weight: 600; color: #ffffff;
    background: #c47d0a; border: 0; border-radius: 10px; cursor: pointer;
    transition: background 0.25s ease;
  }
  .nl-band-btn:hover { background: #a26209; }

  /* ── Pop-up ── */
  .nl-overlay {
    position: fixed; inset: 0; z-index: 390;
    display: flex; align-items: center; justify-content: center;
    padding: 1rem;
    background: rgba(8, 46, 59, 0.55);
    opacity: 0; visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .nl-overlay.is-open { opacity: 1; visibility: visible; }

  .nl-dialog {
    position: relative;
    display: grid; grid-template-columns: 5fr 6fr;
    width: 100%; max-width: 760px;
    background: #ffffff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 64px -16px rgba(8, 46, 59, 0.55);
    transform: translateY(12px);
    transition: transform 0.25s ease;
  }
  .nl-overlay.is-open .nl-dialog { transform: none; }

  .nl-photo { position: relative; min-height: 100%; background: #0d4a5e; }
  .nl-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 68% 50%; display: block; }

  .nl-content { padding: 2.25rem 2rem 1.75rem; border-top: 3px solid #c47d0a; }
  .nl-eyebrow { margin: 0 0 0.625rem; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #c47d0a; }
  .nl-title { margin: 0 0 0.75rem; font-size: 1.625rem; font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; color: #111827; }
  .nl-text { margin: 0 0 1rem; font-size: 0.9375rem; line-height: 1.65; color: #4b5563; }

  .nl-list { list-style: none; margin: 0 0 1.25rem; padding: 0; }
  .nl-list li { position: relative; padding-left: 1.625rem; margin: 0.4rem 0; font-size: 0.9375rem; line-height: 1.5; color: #1f2937; }
  .nl-list li::before {
    content: ""; position: absolute; left: 0.15rem; top: 0.3rem;
    width: 0.6rem; height: 0.35rem;
    border-left: 2px solid #0d4a5e; border-bottom: 2px solid #0d4a5e;
    transform: rotate(-45deg);
  }

  .nl-form { display: flex; flex-direction: column; gap: 0.625rem; }
  .nl-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .nl-input {
    box-sizing: border-box; width: 100%; padding: 0.85rem 1rem;
    font: inherit; font-size: 1rem; color: #111827;
    background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px;
  }
  .nl-input:focus { outline: 2px solid #0d4a5e; outline-offset: 1px; border-color: #0d4a5e; }
  .nl-submit {
    padding: 0.9rem 1.4rem;
    font: inherit; font-size: 0.9375rem; font-weight: 600; color: #ffffff;
    background: #0d4a5e; border: 0; border-radius: 10px; cursor: pointer;
    box-shadow: 0 4px 14px -4px rgba(13, 74, 94, 0.45);
    transition: background 0.25s ease;
  }
  .nl-submit:hover { background: #c47d0a; }
  .nl-error { margin: 0; font-size: 0.8125rem; color: #b91c1c; }

  .nl-consent { margin: 0.875rem 0 0; font-size: 0.75rem; line-height: 1.55; color: #6b7280; }
  .nl-consent a { color: #0d4a5e; text-decoration: underline; }
  .nl-decline {
    display: block; margin: 0.75rem auto 0; padding: 0.25rem 0.5rem;
    font: inherit; font-size: 0.8125rem; color: #6b7280;
    background: none; border: 0; text-decoration: underline; cursor: pointer;
  }

  .nl-close {
    position: absolute; top: 0.75rem; right: 0.75rem; z-index: 2;
    display: flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem;
    color: #475569; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 999px; cursor: pointer;
  }
  .nl-close:hover { color: #0d4a5e; border-color: #0d4a5e; }

  .nl-done { display: none; }
  .nl-dialog.is-done .nl-form, .nl-dialog.is-done .nl-list, .nl-dialog.is-done .nl-text,
  .nl-dialog.is-done .nl-consent, .nl-dialog.is-done .nl-decline { display: none; }
  .nl-dialog.is-done .nl-done { display: block; margin: 0; font-size: 0.9375rem; line-height: 1.65; color: #4b5563; }

  @media (max-width: 640px) {
    .nl-band-inner { flex-direction: column; align-items: stretch; }
    .nl-overlay { align-items: flex-end; padding: 0; }
    .nl-dialog { grid-template-columns: 1fr; max-width: none; border-radius: 18px 18px 0 0; }
    .nl-photo { min-height: 0; height: 132px; }
    .nl-content { padding: 1.375rem 1.25rem 1.25rem; }
    .nl-title { font-size: 1.375rem; }
    .nl-list { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nl-overlay, .nl-dialog { transition: none; }
  }
</style>
