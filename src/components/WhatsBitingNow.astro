---
// "What's biting this month" block — extracted from the homepage so other
// pages (e.g. fiskeri-paa-kysten) can embed the same live monthly picture.
import { monthNames, monthData, speciesHref } from '../data/season-data';

interface Props {
  /** Species to hide from the fish list, e.g. freshwater-only species on a coastal page. */
  excludeSpecies?: string[];
  heading?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  excludeSpecies = [],
  heading = "Hvad bider lige nu?",
  ctaLabel = "Se den fulde sæsonguide",
  ctaHref = "/saesonguide/",
} = Astro.props;

const monthIndex = new Date().getMonth();
const currentMonth = monthNames[monthIndex];
const now = monthData[monthIndex];
const visibleFish = now.fish.filter((f) => !excludeSpecies.includes(f));
---

<div class="sblock" style={`--sc: ${now.color}; --sb: ${now.bg};`}>
  <div class="sblock-left">
    <div class="sblock-badge">
      <span class="sblock-dot"></span>
      Nu i {currentMonth}
    </div>
    <p class="sblock-season">{now.season}</p>
    <h2 class="sblock-title">{heading}</h2>
    <p class="sblock-tip">{now.tip}</p>
    <div class="month-strip" aria-label="Året rundt">
      {monthNames.map((name, i) => (
        <div class={`month-cell ${i === monthIndex ? 'is-now' : ''}`} title={name}>
          <span class="month-bar"></span>
          <span class="month-letter">{name.charAt(0)}</span>
        </div>
      ))}
    </div>
    <a href={ctaHref} class="season-cta">
      {ctaLabel}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M2.5 7h9M7.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
  <div class="sblock-right">
    <p class="sblock-fish-label">Bider nu</p>
    <ul class="fish-chips">
      {visibleFish.map((f, i) => (
        <li>
          <a class={`fish-chip ${i === 0 ? 'is-top' : ''}`} href={speciesHref[f] ?? '#'}>
            <span class="fish-chip-dot" aria-hidden="true"></span>
            <span class="fish-chip-name">{f}</span>
            <span class="fish-chip-tag">{i === 0 ? 'Top' : 'I sæson'}</span>
            <svg class="fish-chip-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2.5 7h9M7.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .sblock {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--sc);
    box-shadow: 0 16px 40px -16px rgba(13, 40, 53, 0.2);
  }

  .sblock-left {
    background: var(--sb);
    padding: 2.5rem 2.75rem;
    border-right: 1px solid var(--sc);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .sblock-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--sc);
    margin-bottom: 0.875rem;
  }

  .sblock-dot {
    width: 7px;
    height: 7px;
    background: var(--sc);
    border-radius: 50%;
    animation: sblock-pulse-dot 2s infinite;
  }

  @keyframes sblock-pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.6; transform: scale(0.8); }
  }

  .sblock-season {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sc);
    opacity: 0.65;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.375rem;
  }

  .sblock-title {
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    font-weight: 700;
    color: #111827;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .sblock-tip {
    font-size: 0.9375rem;
    color: #4b5563;
    line-height: 1.75;
    margin-bottom: 1.5rem;
  }

  .month-strip {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 6px;
    margin: 0 0 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px dashed rgba(15, 23, 42, 0.08);
  }

  .month-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
  }

  .month-bar {
    display: block;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: rgba(15, 23, 42, 0.08);
    transition: background 0.25s ease, height 0.25s ease, box-shadow 0.25s ease;
  }

  .month-cell.is-now .month-bar {
    height: 14px;
    background: var(--sc);
    border-radius: 4px;
    box-shadow: 0 4px 10px -3px var(--sc);
    transform: translateY(-4px);
  }

  .month-letter {
    font-size: 0.625rem;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: color 0.25s ease;
  }

  .month-cell.is-now .month-letter {
    color: var(--sc);
    font-weight: 800;
  }

  .season-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sc);
    border-bottom: 1.5px solid var(--sc);
    padding-bottom: 1px;
    width: fit-content;
    transition: opacity 0.15s, gap 0.15s;
  }

  .season-cta:hover { opacity: 0.75; gap: 9px; }

  .sblock-right {
    background: #ffffff;
    padding: 2.5rem 2.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
  }

  .sblock-fish-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #9ca3af;
    margin-bottom: 0.5rem;
  }

  .fish-chips {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
  }

  .fish-chips li { list-style: none; }

  .fish-chip {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1.125rem;
    background: var(--sb);
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
  }

  .fish-chip:hover {
    transform: translateX(4px);
    border-color: var(--sc);
    background: #ffffff;
    box-shadow: 0 12px 24px -14px rgba(15, 23, 42, 0.22);
  }

  .fish-chip-dot {
    position: relative;
    width: 9px;
    height: 9px;
    background: var(--sc);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .fish-chip-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 2px solid var(--sc);
    border-radius: 50%;
    opacity: 0.22;
  }

  .fish-chip-name {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    letter-spacing: -0.01em;
    flex: 1;
    transition: color 0.18s ease;
  }

  .fish-chip:hover .fish-chip-name {
    color: var(--sc);
  }

  .fish-chip-tag {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sc);
    background: #ffffff;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    border: 1px solid #e5e7eb;
    flex-shrink: 0;
  }

  .fish-chip.is-top .fish-chip-tag {
    color: #ffffff;
    background: var(--sc);
    border-color: var(--sc);
    box-shadow: 0 4px 10px -3px rgba(15, 23, 42, 0.25);
  }

  .fish-chip-arrow {
    color: var(--sc);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .fish-chip:hover .fish-chip-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 700px) {
    .sblock { grid-template-columns: 1fr; }
    .sblock-left { border-right: none; border-bottom: 1px solid var(--sc); padding: 2rem 1.75rem; }
    .sblock-right { padding: 2rem 1.75rem; }
  }
</style>
