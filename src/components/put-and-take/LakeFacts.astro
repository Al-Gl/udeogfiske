---
// Facts box for one put & take lake. Every value comes from the master sheet
// (via src/data/lakes.json); empty values are left out, never guessed.
import { type Lake, ownWebsite, websiteLabel, yesNo, formatDate } from '../../lib/lakes';

interface Props { lake: Lake }
const { lake } = Astro.props;
const site = ownWebsite(lake);
const phone = lake.phone.replace(/^\+45/, '').replace(/(\d{2})(?=\d)/g, '$1 ').trim();
const tiles = [
  ['Åbningstider', lake.hours],
  ['Fiskearter', lake.species.join(', ')],
  ['Udsætning', lake.stocking],
  ['Faciliteter', lake.facilities.join(', ')],
].filter(([, v]) => v);
const small = [
  ['Antal søer', lake.lakesCount ? String(lake.lakesCount) : ''],
  ['Børnesø', yesNo(lake.kidsLake)],
  ['Flue- / C&R-sø', yesNo(lake.flyLake)],
].filter(([, v]) => v && v !== '–');
const prices = lake.prices.filter((p) => p.label);
---

<section class="lf" aria-labelledby="lf-title">
  <div class="lf-head">
    <h2 id="lf-title" class="lf-title">Fakta om søen</h2>
    <span class="lf-checked">Tjekket {formatDate(lake.lastChecked)}</span>
  </div>

  <div class="lf-contact">
    {lake.address && <span><b>Adresse</b>{lake.address}</span>}
    {site && <span><b>Hjemmeside</b><a href={site} rel="noopener" target="_blank">{websiteLabel(site).split('/')[0]}</a></span>}
    {phone && <span><b>Telefon</b><a href={`tel:${lake.phone}`}>{phone}</a></span>}
    {lake.mapsUrl && <span><b>Kort</b><a href={lake.mapsUrl} rel="noopener" target="_blank">Se på Google Maps</a></span>}
  </div>

  {small.length > 0 && (
    <div class="lf-small">
      {small.map(([k, v]) => <span><b>{k}</b>{v}</span>)}
    </div>
  )}

  <dl class="lf-tiles">
    {tiles.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
  </dl>

  {prices.length > 0 && (
    <>
      <h3 class="lf-sub">Priser</h3>
      <ul class="lf-prices">
        {prices.map((p) => (
          <li><span>{p.label}</span><strong>{p.kr ? `${p.kr.toLocaleString('da-DK')} kr.` : ''}</strong></li>
        ))}
      </ul>
    </>
  )}

  {lake.rules && (<div class="lf-rules"><h3 class="lf-sub">Regler</h3><p>{lake.rules}</p></div>)}

  <p class="lf-meta">
    Kilder:
    {lake.sources.map((s, i) => (<>{i > 0 && ', '}<a href={s} rel="noopener nofollow" target="_blank">{websiteLabel(s).split('/')[0]}</a></>))}.
    Priser og regler kan ændre sig, så tjek søens egen side før turen. Ser du en fejl? Skriv til <a href="mailto:hej@udeogfiske.dk">hej@udeogfiske.dk</a>.
  </p>
</section>

<style>
  .lf { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 1.5rem; margin: 0 0 2.75rem; box-shadow: 0 8px 24px -18px rgba(13, 74, 94, 0.35); }
  .lf-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem; margin-bottom: 1rem; }
  .lf-title { font-size: 1.25rem; font-weight: 700; color: #111827; letter-spacing: -0.015em; }
  .lf-checked { font-size: 0.75rem; font-weight: 600; color: #0d4a5e; background: #e6f1f5; border-radius: 999px; padding: 0.25rem 0.65rem; }
  .lf-contact { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem 1.5rem; padding-bottom: 1.125rem; margin-bottom: 1.125rem; border-bottom: 1px solid #eef2f7; font-size: 0.9375rem; color: #111827; }
  .lf-contact b, .lf-small b { display: block; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280; }
  .lf-contact a, .lf-meta a { color: #0d4a5e; text-decoration: underline; text-underline-offset: 2px; }
  .lf-small { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-bottom: 1rem; }
  .lf-small span { background: #f8fafc; border: 1px solid #eef2f7; border-radius: 10px; padding: 0.5rem 0.875rem; font-size: 0.9375rem; font-weight: 600; color: #111827; }
  .lf-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .lf-tiles div { background: #f8fafc; border: 1px solid #eef2f7; border-radius: 12px; padding: 0.875rem 1rem; }
  .lf-tiles dt { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #0d4a5e; margin-bottom: 0.25rem; }
  .lf-tiles dd { font-size: 0.9375rem; color: #374151; line-height: 1.55; }
  .lf-sub { font-size: 1rem; font-weight: 700; color: #111827; margin: 1.5rem 0 0.75rem; }
  .lf-prices { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.5rem; }
  .lf-prices li { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; border: 1px solid #e5e7eb; border-radius: 10px; padding: 0.55rem 0.8rem; font-size: 0.875rem; color: #374151; }
  .lf-prices strong { color: #0d4a5e; font-size: 0.9375rem; white-space: nowrap; }
  .lf-rules { background: #fff8eb; border-left: 4px solid #c47d0a; border-radius: 10px; padding: 0.25rem 1rem 0.875rem; margin-top: 1.25rem; }
  .lf-rules .lf-sub { margin-top: 0.75rem; margin-bottom: 0.35rem; }
  .lf-rules p { font-size: 0.9375rem; color: #374151; line-height: 1.7; }
  .lf-meta { font-size: 0.8125rem; color: #6b7280; line-height: 1.6; margin-top: 1.25rem; }
  @media (max-width: 600px) {
    .lf { padding: 1.25rem 1rem; }
    .lf-contact, .lf-tiles { grid-template-columns: 1fr; }
  }
</style>
