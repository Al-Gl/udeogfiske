---
// "Praktisk information" for one put & take lake, styled like the practical-info
// section of a printed guidebook: spec-sheet rows, a menu-style price list and
// numbered rules. Every value comes from the master sheet (src/data/lakes.json);
// empty values are left out, never guessed.
import { type Lake, ownWebsite, websiteLabel, formatDate } from '../../lib/lakes';

interface Props { lake: Lake }
const { lake } = Astro.props;
const site = ownWebsite(lake);
const phone = lake.phone.replace(/^\+45/, '').replace(/(\d{2})(?=\d)/g, '$1 ').trim();
const directions = lake.lat != null
  ? `https://www.google.com/maps/dir/?api=1&destination=${lake.lat},${lake.lng}`
  : lake.mapsUrl;

// Split text into sentences, but not after abbreviations like "Maks." or "Kl.".
const sentences = (t: string) =>
  t.split(/(?<!\b(?:[Mm]aks|[Kk]l|[Ii]nkl|ca|[Nn]r|[Mm]in|u|[Ff]x|osv|bl\.a|[Bb]ørn u)\.)(?<=\.)\s+(?=[A-ZÆØÅÉ0-9])/)
    .map((s) => s.trim()).filter(Boolean);
const cap = (s: string) => (s ? s[0].toUpperCase() + s.slice(1) : s);

// Hours: first sentence in the row (without "(Google Maps)" etc.), the rest as a small note.
const hoursParts = sentences(lake.hours);
const hoursFirst = hoursParts[0] ?? '';
const hoursSource = hoursFirst.match(/\(([^)]+)\)/)?.[1];
const hoursMain = hoursFirst.replace(/\s*\([^)]*\)/, '').replace(/\.$/, '');
const hoursNote = [
  ...hoursParts.slice(1),
  ...(!hoursSource ? [] : /^se /i.test(hoursSource) ? [`${cap(hoursSource)} for de aktuelle tider.`] : [`Tiden er fra ${hoursSource}.`]),
].join(' ');

const lakesLine = [
  lake.lakesCount ? `${lake.lakesCount} ${lake.lakesCount === 1 ? 'sø' : 'søer'}` : '',
  lake.kidsLake ? 'børnesø' : '',
  lake.flyLake ? 'flue- eller catch & release-fiskeri' : '',
].filter(Boolean).join(', ');

const isHourly = (l: string) => /^\d+\s*timer$/i.test(l.trim());
const hourly = lake.prices.filter((p) => isHourly(p.label));
const other = lake.prices.filter((p) => !isHourly(p.label));
const kr = (n: number | null) => (n ? `${n.toLocaleString('da-DK')} kr.` : '');
const rules = sentences(lake.rules).map((r) => r.replace(/\.$/, ''));
---

<section class="pi" aria-labelledby="pi-title">
  <header class="pi-head">
    <h2 id="pi-title">Praktisk information</h2>
    <p class="pi-date">Tjekket {formatDate(lake.lastChecked)}</p>
  </header>

  <dl class="pi-rows">
    {lake.address && (
      <div>
        <dt>Adresse</dt>
        <dd>{lake.address}{directions && <> <a class="pi-link" href={directions} rel="noopener" target="_blank">Rutevejledning&nbsp;↗</a></>}</dd>
      </div>
    )}
    {hoursMain && (
      <div>
        <dt>Åbent</dt>
        <dd>{cap(hoursMain)}{hoursNote && <span class="pi-note">{hoursNote}</span>}</dd>
      </div>
    )}
    {phone && <div><dt>Telefon</dt><dd><a href={`tel:${lake.phone}`}>{phone}</a></dd></div>}
    {site && <div><dt>Hjemmeside</dt><dd><a href={site} rel="noopener" target="_blank">{websiteLabel(site).split('/')[0]}</a></dd></div>}
    {lake.species.length > 0 && <div><dt>Fisk</dt><dd>{cap(lake.species.join(', '))}</dd></div>}
    {lake.stocking && <div><dt>Udsætning</dt><dd>{lake.stocking}</dd></div>}
    {lakesLine && <div><dt>Søerne</dt><dd>{cap(lakesLine)}</dd></div>}
    {lake.facilities.length > 0 && <div><dt>Faciliteter</dt><dd>{cap(lake.facilities.join(', '))}</dd></div>}
  </dl>

  {lake.prices.length > 0 && (
    <div class="pi-block">
      <h3>Priser</h3>
      <div class="pi-prices">
        {hourly.length > 0 && (
          <ul>
            {hourly.map((p) => <li><span>{p.label}</span><i aria-hidden="true"></i><b>{kr(p.kr)}</b></li>)}
          </ul>
        )}
        {other.length > 0 && (
          <ul>
            {other.map((p) => <li><span>{p.label}</span><i aria-hidden="true"></i><b>{kr(p.kr)}</b></li>)}
          </ul>
        )}
      </div>
    </div>
  )}

  {rules.length > 0 && (
    <div class="pi-block">
      <h3>Regler</h3>
      <ol class="pi-rules">{rules.map((r) => <li>{r}</li>)}</ol>
    </div>
  )}

  <p class="pi-src">
    Kilde: {lake.sources.map((s, i) => (<>{i > 0 && ', '}<a href={s} rel="noopener nofollow" target="_blank">{websiteLabel(s).split('/')[0]}</a></>))}.
    Priser og regler kan ændre sig, så tjek søens egen side, før du kører. Har vi en fejl? Skriv til <a href="mailto:hej@udeogfiske.dk">hej@udeogfiske.dk</a>.
  </p>
</section>

<style>
  .pi {
    border-top: 3px solid #0d4a5e;
    border-bottom: 1px solid #d6dde2;
    margin: 0 0 3rem;
    padding: 1.25rem 0 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  .pi-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.25rem 1rem; margin-bottom: 0.5rem; }
  .pi-head h2 { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #0d4a5e; }
  .pi-date { font-size: 0.8125rem; font-style: italic; color: #6b7280; }

  .pi-rows > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid #e8ecef;
  }
  .pi-rows > div:last-child { border-bottom: 0; }
  .pi-rows dt { font-size: 0.8125rem; font-weight: 600; color: #6b7280; padding-top: 0.1rem; }
  .pi-rows dd { font-size: 0.96875rem; color: #1f2937; line-height: 1.6; }
  .pi-rows dd a { color: #0d4a5e; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .pi-link { margin-left: 0.5rem; font-size: 0.875rem; font-weight: 600; white-space: nowrap; }
  .pi-note { display: block; font-size: 0.8125rem; color: #6b7280; margin-top: 0.15rem; }

  .pi-block { border-top: 1px solid #d6dde2; margin-top: 0.5rem; padding-top: 1.25rem; }
  .pi-block + .pi-block { margin-top: 1.5rem; }
  .pi-block h3 { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #0d4a5e; margin-bottom: 0.75rem; }

  .pi-prices { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2.5rem; }
  .pi-prices ul { list-style: none; }
  .pi-prices li { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.3rem 0; font-size: 0.9375rem; color: #1f2937; }
  .pi-prices li span { flex: 0 1 auto; }
  .pi-prices li i { flex: 1 1 1.5rem; min-width: 1.5rem; border-bottom: 1px dotted #a8b3bb; transform: translateY(-0.25rem); }
  .pi-prices li b { flex: 0 0 auto; font-weight: 600; color: #111827; }

  .pi-rules { list-style: none; counter-reset: r; display: grid; gap: 0.55rem; }
  .pi-rules li { counter-increment: r; position: relative; padding-left: 2rem; font-size: 0.9375rem; color: #1f2937; line-height: 1.55; }
  .pi-rules li::before { content: counter(r); position: absolute; left: 0; top: 0; width: 1.25rem; text-align: right; font-weight: 700; color: #c47d0a; }

  .pi-src { font-size: 0.8125rem; color: #8a949c; line-height: 1.6; margin-top: 1.5rem; }
  .pi-src a { color: #6b7280; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 640px) {
    .pi-rows > div { grid-template-columns: 1fr; gap: 0.1rem; padding: 0.7rem 0; }
    .pi-rows dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; }
    .pi-prices { grid-template-columns: 1fr; }
    .pi-prices ul + ul { margin-top: 0.75rem; }
    .pi-link { display: inline-block; margin: 0.2rem 0 0; }
  }
</style>
