---
// Shell for a put & take region page. The page passes its own intro text and links;
// counts, prices, lake cards and the table are computed from src/data/lakes.json.
import MainLayout from '../../layouts/MainLayout.astro';
import GuideLink from '../GuideLink.astro';
import LakeTable from './LakeTable.astro';
import LakeCard from './LakeCard.astro';
import PtHero from './PtHero.astro';
import '../../styles/put-and-take.css';
import { type RegionSlug, lakesInRegion, hasPage, lakeUrl, lakeName, lakeImage, ownWebsite, priceStats, BASE } from '../../lib/lakes';

interface Props {
  region: RegionSlug;
  name: string;          // "Sjælland"
  inName: string;        // "på Sjælland" / "i Vestjylland"
  intro: string[];       // paragraphs (may contain links)
  spots?: { href: string; title: string; desc: string }[];
}
const { region, name, inName, intro, spots = [] } = Astro.props;
const all = lakesInRegion(region);
const pages = all.filter(hasPage).sort((a, b) => Number(b.visited) - Number(a.visited) || b.searchVolume - a.searchVolume);
// Lakes without a page yet, most searched / most reviewed first (shown as cards to their own site)
const more = all.filter((l) => !hasPage(l) && ownWebsite(l)).sort((a, b) => b.searchVolume + b.reviews * 2 - (a.searchVolume + a.reviews * 2)).slice(0, pages.length ? 3 : 6);
const stats = priceStats(3, pages) ?? priceStats(2, pages);
const url = `https://udeogfiske.dk${BASE}/${region}/`;
const hero = lakeImage({ slug: pages[0]?.slug ?? region }, true);

const faq = [
  { question: `Hvor mange put and take søer er der ${inName}?`, answer: `I vores oversigt er der ${all.length} åbne put and take søer ${inName}. ${pages.length ? `${pages.length} af dem har en side med priser, regler og fakta, og vi tilføjer løbende flere.` : 'Vi tilføjer løbende sider med priser og regler for de enkelte søer.'}` },
  ...(stats && stats.n >= 2 ? [{ question: `Hvad koster put and take ${inName}?`, answer: `Et fiskekort til ${stats.hours} timer koster mellem ${stats.min} og ${stats.max} kr. i de ${stats.n} søer ${inName}, vi har tjekket. De fleste søer har også kortere og længere kort, børnepriser og dagskort – se den enkelte sø.` }] : []),
];
const title = `Put and take ${name}: alle søer med priser og regler`;
const description = `Oversigt over ${all.length} put and take søer ${inName} – priser, fiskearter, børnesøer og åbningstider for de enkelte søer. Find også den sø, der ligger nærmest dig.`;
---

<MainLayout
  title={title}
  description={description}
  canonical={url}
  ogImage={`https://udeogfiske.dk${hero.src}`}
  pageType="category"
  breadcrumbs={[
    { name: 'Forside', url: '/' },
    { name: 'Fiskepladser', url: '/fiskepladser/' },
    { name: 'Put & Take', url: `${BASE}/` },
    { name },
  ]}
  itemList={pages.map((l) => ({ name: lakeName(l), url: lakeUrl(l) }))}
  faq={faq}
>
  <PtHero
    crumbs={[{ name: 'Forside', url: '/' }, { name: 'Fiskepladser', url: '/fiskepladser/' }, { name: 'Put & Take', url: `${BASE}/` }, { name }]}
    title={`Put and take ${inName}`}
    sub={`Alle put and take søer ${inName} – med priser, fiskearter og regler for de søer, vi har tjekket.`}
    image={hero}
    stats={[
      { value: String(all.length), label: 'Søer' },
      { value: String(pages.length), label: 'Med priser og regler' },
      ...(stats && stats.n >= 2 ? [{ value: `${stats.min}–${stats.max} kr.`, label: `${stats.hours} timers fiskekort` }] : []),
    ]}
  />

  <section class="pt-body">
    <div class="pt-ctn">
      <div class="pt-narrow">
        <div class="answer-capsule">
          <span class="ac-label">Kort fortalt</span>
          <h2 class="ac-q">Hvor kan du fiske put and take {inName}?</h2>
          <p class="ac-a">
            Der er <strong>{all.length} åbne put and take søer</strong> {inName} i vores oversigt.
            {stats && stats.n >= 2 && <> Et fiskekort til {stats.hours} timer koster <strong>{stats.min}–{stats.max} kr.</strong> i de søer, vi har tjekket.</>}
            {' '}Brug knappen <em>Vis nærmeste søer</em> længere nede for at finde den sø, der ligger tættest på dig.
          </p>
        </div>
        <div class="article">
          {intro.map((p) => <p set:html={p} />)}
        </div>
      </div>

      {pages.length > 0 && (
        <>
          <header class="pt-sec">
            <span class="pt-eyebrow">Søer med priser og regler</span>
            <h2>Put and take søer {inName}, vi har tjekket</h2>
          </header>
          <div class="pt-grid">
            {pages.map((l) => <LakeCard lake={l} />)}
          </div>
        </>
      )}

      {more.length > 0 && (
        <>
          <header class="pt-sec">
            <span class="pt-eyebrow">Flere søer</span>
            <h2>{pages.length ? 'Andre populære søer' : 'Populære søer'} {inName}</h2>
            <p>Dem har vi ikke lavet en side om endnu – kortet fører til søens egen hjemmeside.</p>
          </header>
          <div class="pt-grid">
            {more.map((l) => <LakeCard lake={l} />)}
          </div>
        </>
      )}
    </div>

    <div class="pt-band">
      <div class="pt-ctn">
        <header class="pt-sec">
          <span class="pt-eyebrow">Hele listen</span>
          <h2>Alle put and take søer {inName}</h2>
        </header>
        <div class="pt-panel">
          <LakeTable lakes={all} />
        </div>
      </div>
    </div>

    <div class="pt-ctn">
      <div class="pt-narrow">
        <header class="pt-sec">
          <span class="pt-eyebrow">Mere fiskeri</span>
          <h2>Guides {inName}</h2>
        </header>
        {spots.map((s) => <GuideLink href={s.href} title={s.title} desc={s.desc} />)}
        <GuideLink href="/fiskeguide/put-take-fiskeri/" title="Læs min guide til put and take fiskeri" desc="Grej, agn og hvordan din første tur foregår." />
        <GuideLink href={`${BASE}/`} title="Put and take i hele Danmark" desc="Oversigten over alle søer, region for region." />

        <h2 id="faq" class="faq-heading">Ofte stillede spørgsmål</h2>
        <div class="faq-list">
          {faq.map((f) => (
            <details class="faq-item">
              <summary><h3>{f.question}</h3></summary>
              <div class="faq-answer"><p set:html={f.answer} /></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>
