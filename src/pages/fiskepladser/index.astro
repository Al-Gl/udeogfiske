---
import MainLayout from '../../layouts/MainLayout.astro';

const sjaelland = [
  {
    title: "Stevns",
    href: "/fiskepladser/stevns/",
    image: "/images/stevns_card.png",
    alt: "Havørredfiskeri ved Stevns Klint",
  },
  {
    title: "Isefjorden",
    href: "/fiskepladser/isefjorden/",
    image: "/images/isefjorden_card.png",
    alt: "Havørredfiskeri i Isefjorden",
  },
  {
    title: "Roskilde Fjord",
    href: "/fiskepladser/roskilde-fjord/",
    image: "/images/roskilde_fjord_card.png",
    alt: "Fiskeri i Roskilde Fjord ved solnedgang",
  },
  {
    title: "København",
    href: "/fiskepladser/koebenhavn/",
    image: "/images/koebenhavn_card.png",
    alt: "Fisker i waders ved Københavns kyst",
  },
];

const jylland = [
  {
    title: "Mariager Fjord",
    href: "/fiskepladser/mariager-fjord/",
    image: "/images/mariager_fjord_card.png",
    alt: "Mariager Fjord med sivkant ved solnedgang",
  },
  {
    title: "Randers Fjord",
    href: "/fiskepladser/randers-fjord/",
    image: "/images/randers_fjord_card.jpg",
    alt: "Randers Fjord med sivkanter og bro i aftenlys",
  },
];

const fyn = [
  {
    title: "Ærø",
    href: "/fiskepladser/aeroe/",
    image: "/images/aeroe_card.jpg",
    alt: "Stenstrand med blæretang og lave klinter på Ærø",
  },
];

const putTake = [
  {
    title: "Put & Take",
    href: "/fiskepladser/put-and-take/",
    image: "/images/put_take_fiskeri_card.png",
    alt: "Regnbueørred fanget i dansk Put & Take sø",
  },
];

const allLocations = [...sjaelland, ...jylland, ...fyn, ...putTake];
---

<MainLayout
  title="Fiskepladser i Danmark | Ude og Fiske"
  description="Find de bedste fiskepladser i Danmark. Testede og dokumenterede pladser langs kyster, fjorde og åer — så du ved præcis hvor du skal fiske."
  canonical="https://udeogfiske.dk/fiskepladser/"
  pageType="category"
  breadcrumbs={[{ name: "Forside", url: "/" }, { name: "Fiskepladser" }]}
  itemList={allLocations.map(l => ({ name: l.title, url: l.href }))}
>

  <section class="pg-hero">
    <div class="pg-ctn">
      <nav class="pg-bc">
        <a href="/">Forside</a>
        <span>›</span>
        <span>Fiskepladser</span>
      </nav>
      <h1 class="pg-title">Fiskepladser</h1>
      <p class="pg-sub">Testede og dokumenterede fiskepladser i Danmark — så du aldrig er i tvivl om hvor du skal tage hen.</p>
    </div>
  </section>

  <section class="pg-body">
    <div class="pg-ctn">
      <div class="pg-intro">
        <p>Alle har stået i situationen hvor de gerne vil ud og fiske, men de ved simpelthen ikke hvor de skal fiske. Alle kan jo i bund og grund tage en fiskestang, tage ud til kysten, en å eller en sø og begynde at kaste snøren ud.</p>
        <p>Jeg har altid med glæde delt mine fiskepladser med alle — for der er nok fisk til os alle, og jo flere der kommer ud og fisker, jo bedre for fiskeriet i Danmark.</p>
      </div>

      <h2 class="region-title">Fiskepladser i Sjælland</h2>
      <div class="card-grid">
        {sjaelland.map((c) => (
          <a href={c.href} class="card" aria-label={c.title}>
            <img src={c.image} alt={c.alt} loading="lazy" width="600" height="400" class="card-img" />
            <div class="card-overlay">
              <h3 class="card-title">{c.title}</h3>
              <span class="card-arrow">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M5 9h8M9.5 5.5l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="region-title">Fiskepladser i Jylland</h2>
      <div class="card-grid">
        {jylland.map((c) => (
          <a href={c.href} class="card" aria-label={c.title}>
            <img src={c.image} alt={c.alt} loading="lazy" width="600" height="400" class="card-img" />
            <div class="card-overlay">
              <h3 class="card-title">{c.title}</h3>
              <span class="card-arrow">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M5 9h8M9.5 5.5l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="region-title">Fiskepladser i Fyn</h2>
      <div class="card-grid">
        {fyn.map((c) => (
          <a href={c.href} class="card" aria-label={c.title}>
            <img src={c.image} alt={c.alt} loading="lazy" width="600" height="400" class="card-img" />
            <div class="card-overlay">
              <h3 class="card-title">{c.title}</h3>
              <span class="card-arrow">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M5 9h8M9.5 5.5l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="region-title">Put &amp; Take søer</h2>
      <div class="card-grid">
        {putTake.map((c) => (
          <a href={c.href} class="card" aria-label={c.title}>
            <img src={c.image} alt={c.alt} loading="lazy" width="600" height="400" class="card-img" />
            <div class="card-overlay">
              <h3 class="card-title">{c.title}</h3>
              <span class="card-arrow">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M5 9h8M9.5 5.5l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


</MainLayout>

<style>
  .pg-hero {
    background: #0d4a5e;
    padding: 3.5rem 0 3rem;
  }

  .pg-ctn {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .pg-bc {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.5);
    margin-bottom: 1.25rem;
  }

  .pg-bc a { color: rgba(255,255,255,0.5); transition: color 0.15s; }
  .pg-bc a:hover { color: rgba(255,255,255,0.85); }

  .pg-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.875rem;
  }

  .pg-sub {
    font-size: 1.0625rem;
    font-weight: 300;
    color: rgba(255,255,255,0.65);
    line-height: 1.65;
    max-width: 520px;
  }

  .pg-body { padding: 3.5rem 0 5rem; }

  .region-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: #111827;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    padding-top: 0.5rem;
  }

  .region-empty {
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.7;
    margin-bottom: 3rem;
    padding: 1.125rem 1.25rem;
    background: #f8fafc;
    border: 1px dashed #d1d5db;
    border-radius: 10px;
  }

  .region-empty a {
    color: #0d4a5e;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .region-empty a:hover { color: #c47d0a; }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: 14px;
    overflow: hidden;
    background: #0d4a5e;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px -14px rgba(13, 74, 94, 0.45);
  }
  .card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .card:hover .card-img { transform: scale(1.06); }
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.25) 45%, rgba(0,0,0,0) 70%);
    pointer-events: none;
  }
  .card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 1.25rem 1.25rem;
  }
  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.015em;
    line-height: 1.25;
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  }
  .card-arrow {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255,255,255,0.18);
    color: #ffffff;
    backdrop-filter: blur(6px);
    transition: background 0.2s, transform 0.2s;
  }
  .card:hover .card-arrow {
    background: #ffffff;
    color: #0d4a5e;
    transform: translateX(3px);
  }
  @media (max-width: 720px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .card-grid { grid-template-columns: 1fr; }
  }

  .pg-intro {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-bottom: 2.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .pg-intro p {
    font-size: 0.9375rem;
    color: #4b5563;
    line-height: 1.8;
  }
</style>
