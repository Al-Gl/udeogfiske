---
// One page per put & take lake with level page/visited in the master sheet.
// Facts: src/data/lakes.json (npm run lakes). Text: src/content/lakes/{slug}.md.
// Ørsted has its own hand-written page (oersted-oerredvand/) and is skipped here.
import MainLayout from '../../../layouts/MainLayout.astro';
import TipBox from '../../../components/TipBox.astro';
import GuideLink from '../../../components/GuideLink.astro';
import LakeFacts from '../../../components/put-and-take/LakeFacts.astro';
import '../../../styles/put-and-take.css';
import {
  type Lake, pageLakes, lakeText, lakeUrl, regionName, regionUrl, nearest, hasPage,
  ownWebsite, websiteLabel, formatDate, cheapestTicket, lakeName,
} from '../../../lib/lakes';

export function getStaticPaths() {
  return pageLakes()
    .filter((l) => l.slug !== 'oersted-oerredvand')
    .map((lake) => ({ params: { slug: lake.slug }, props: { lake } }));
}

const { lake } = Astro.props as { lake: Lake };
const text = lakeText(lake.slug)!;
const fm = text.frontmatter as any;
const { Content } = text;
const name: string = fm.name ?? lake.name;
const url = `https://udeogfiske.dk${lakeUrl(lake)}`;
const checked = formatDate(lake.lastChecked);
const from = cheapestTicket(lake);

const title = fm.title ?? `${name} – priser, åbningstider og fisk`;
const description = fm.description ??
  `${name} ved ${lake.town}: ${from ? `fiskekort fra ${from.replace(' / ', ' for ').replace(' t.', ' timer')}, ` : ''}fiskearter, åbningstider, regler og faciliteter. Tjekket ${checked}.`;

// FAQ: two answers built from the facts + the lake's own questions.
const priceList = lake.prices.filter((p) => p.kr).slice(0, 4).map((p) => `${p.label}: ${p.kr} kr.`).join(', ');
const faq = [
  ...(priceList ? [{ question: `Hvad koster det at fiske i ${name}?`, answer: `${priceList}. Priserne er tjekket ${checked} på søens egen hjemmeside – se den fulde prisliste ovenfor.` }] : []),
  ...(lake.species.length ? [{ question: `Hvilke fisk kan man fange i ${name}?`, answer: `Søen oplyser: ${lake.species.join(', ')}.${lake.stocking ? ' ' + lake.stocking : ''}` }] : []),
  ...(fm.faq ?? []),
];

const street = lake.address.split(',')[0];
const schema = [{
  '@type': 'TouristAttraction',
  '@id': `${url}#lake`,
  name,
  description: fm.summary,
  url: ownWebsite(lake) || undefined,
  telephone: lake.phone || undefined,
  address: { '@type': 'PostalAddress', streetAddress: street, postalCode: lake.zip, addressLocality: lake.town, addressCountry: 'DK' },
  ...(lake.lat != null ? { geo: { '@type': 'GeoCoordinates', latitude: lake.lat, longitude: lake.lng } } : {}),
  isAccessibleForFree: false,
  publicAccess: true,
  subjectOf: { '@id': `${url}#webpage` },
}];

const near = nearest(lake, 3);
---

<MainLayout
  title={title}
  description={description}
  canonical={url}
  pageType="article"
  breadcrumbs={[
    { name: 'Forside', url: '/' },
    { name: 'Fiskepladser', url: '/fiskepladser/' },
    { name: 'Put & Take', url: '/fiskepladser/put-and-take/' },
    { name: regionName(lake.region), url: regionUrl(lake.region) },
    { name },
  ]}
  articleData={{ headline: `${name}`, image: '/images/put_take_hero.png', datePublished: lake.lastChecked, dateModified: lake.lastChecked }}
  faq={faq}
  extraSchema={schema}
>
  <section class="pt-hero">
    <div class="pt-ctn">
      <nav class="pt-bc" aria-label="Brødkrumme">
        <a href="/">Forside</a><span>›</span>
        <a href="/fiskepladser/">Fiskepladser</a><span>›</span>
        <a href="/fiskepladser/put-and-take/">Put &amp; Take</a><span>›</span>
        <a href={regionUrl(lake.region)}>{regionName(lake.region)}</a><span>›</span>
        <span>{name}</span>
      </nav>
      <h1 class="pt-title">{name}</h1>
      <p class="pt-sub">Put and take ved {lake.town} – priser, fiskearter, åbningstider og regler samlet ét sted. Tjekket {checked}.</p>
      {lake.visited && <span class="pt-badge">Jeg har fisket her</span>}
    </div>
  </section>

  <section class="pt-body">
    <div class="pt-ctn pt-narrow">
      <div class="answer-capsule">
        <span class="ac-label">Kort fortalt</span>
        <h2 class="ac-q">Hvad skal du vide om {name}?</h2>
        <p class="ac-a" set:html={fm.summary} />
      </div>

      <LakeFacts lake={lake} />

      <article class="article">
        <Content />
      </article>

      {fm.tip && <TipBox><p set:html={fm.tip} /></TipBox>}

      <GuideLink href="/fiskeguide/put-take-fiskeri/" title="Læs min guide til put and take fiskeri" desc="Grej, agn, Powerbait og spinnere – og hvordan din første tur foregår." />
      <GuideLink href="/guide-til-fisk/regnbueorredfiskeri/" title="Læs guiden til regnbueørred" desc="Den fisk du oftest fanger i put and take – og hvordan du finder den i søen." />

      <h2 class="pt-h2">Put and take søer i nærheden af {name}</h2>
      <div class="pt-cards">
        {near.map(({ lake: o, km }) => {
          const site = ownWebsite(o);
          const inner = (<><strong>{lakeName(o)}</strong><span>{o.town} · {Math.round(km)} km{cheapestTicket(o) ? ` · fra ${cheapestTicket(o)}` : ''}</span></>);
          return hasPage(o)
            ? <a class="pt-card" href={lakeUrl(o)}>{inner}</a>
            : site
              ? <a class="pt-card" href={site} rel="noopener nofollow" target="_blank">{inner}<span>{websiteLabel(site).split('/')[0]}</span></a>
              : <div class="pt-card">{inner}</div>;
        })}
      </div>
      <p class="article"><a href={regionUrl(lake.region)}>Se alle put and take søer i {regionName(lake.region)}</a> eller <a href="/fiskepladser/put-and-take/">hele oversigten over Danmark</a>.</p>

      <h2 id="faq" class="faq-heading">Ofte stillede spørgsmål om {name}</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <details class="faq-item">
            <summary><h3>{f.question}</h3></summary>
            <div class="faq-answer"><p set:html={f.answer} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
