---
// Put & take hub: every lake in the master sheet (src/data/lakes.json), region pages,
// and answers computed from the lakes we have checked.
import MainLayout from '../../../layouts/MainLayout.astro';
import GuideLink from '../../../components/GuideLink.astro';
import LakeTable from '../../../components/put-and-take/LakeTable.astro';
import '../../../styles/put-and-take.css';
import { lakes, REGIONS, pageLakes, lakesInRegion, lakeUrl, lakeName, priceStats, cheapestTicket, BASE } from '../../../lib/lakes';

const pages = pageLakes().sort((a, b) => b.searchVolume - a.searchVolume);
const p2 = priceStats(2);
const p3 = priceStats(3);
const regionCards = REGIONS.filter((r) => r.slug === r.page)
  .map((r) => ({ ...r, count: lakesInRegion(r.slug).length }))
  .sort((a, b) => b.count - a.count);
const most = regionCards[0];

const priceAnswer = [
  p2 && `Et fiskekort til 2 timer koster mellem <strong>${p2.min} og ${p2.max} kr.</strong> i de ${p2.n} søer, vi har tjekket`,
  p3 && `et 3-timers kort koster ${p3.min}–${p3.max} kr. (typisk omkring ${p3.median} kr.)`,
].filter(Boolean).join(', og ') +
  '. Mange søer har også dagskort, familiekort og børnepriser, og flere giver rabat til pensionister på hverdage. Fangstgrænsen følger som regel fiskekortet – ofte én fisk pr. time.';

const faqs = [
  { question: 'Hvad koster det at fiske put and take?', answer: priceAnswer },
  { question: 'Hvor mange put and take søer er der i Danmark?', answer: `Vi har registreret <strong>${lakes.length} åbne put and take søer</strong> i Danmark. Flest ligger der i ${most.name} (${most.count} søer). Oversigten bygger på Google Maps og søernes egne hjemmesider og bliver opdateret løbende.` },
  { question: 'Skal man have fisketegn for at fiske put and take?', answer: 'Nej. I en put and take sø betaler du for at fiske i søen, og <strong>fisketegn er ikke nødvendigt</strong>. Det gør put and take til et nemt sted at starte, også for børn. Læs mere i min <a href="/fiskeguide/fisketegn/">guide til fisketegn</a>.' },
  { question: 'Hvad er det bedste at fiske med i put and take?', answer: 'De klassiske valg er <strong>Powerbait</strong> under en prop eller på bunden, <strong>regnorm</strong> og <strong>små spinnere og blink</strong>. Mange søer har regler for agn – fx kun regnorm som levende agn og en maksimal vægt på blink – så tjek altid søens regler. Se min <a href="/fiskeguide/put-take-fiskeri/">guide til put and take fiskeri</a> og <a href="/fiskeguide/put-take-fiskeri/spinnefiskeri-i-put-take/">spinnefiskeri i put and take</a>.' },
  { question: 'Må man tage fiskene med hjem fra en put and take sø?', answer: 'Ja – det er hele idéen med put and take. I flere søer <strong>skal</strong> ørrederne tages med hjem og må ikke genudsættes, mens andre arter som stør og karper altid skal genudsættes. Hvor mange ørreder du må tage, står på dit fiskekort.' },
  { question: 'Hvornår er det bedste tidspunkt at fiske i put and take?', answer: '<strong>Forår (april–juni)</strong> og <strong>efterår (september–november)</strong> er typisk de bedste perioder – vandtemperaturen ligger på 8–14 grader, og fiskene er aktive højt i vandet. Midt om sommeren går fiskene dybt for at finde køligere vand. Tidligt om morgenen og sent på eftermiddagen er konsekvent de bedste timer.' },
];
---

<MainLayout
  title="Put and take søer i Danmark: priser og de bedste søer"
  description={`Oversigt over ${lakes.length} put and take søer i Danmark – priser, fiskearter, børnesøer og regler, region for region. Find den sø, der ligger nærmest dig.`}
  canonical="https://udeogfiske.dk/fiskepladser/put-and-take/"
  pageType="category"
  breadcrumbs={[
    { name: 'Forside', url: '/' },
    { name: 'Fiskepladser', url: '/fiskepladser/' },
    { name: 'Put & Take' },
  ]}
  itemList={pages.map((l) => ({ name: lakeName(l), url: lakeUrl(l) }))}
  faq={faqs}
>
  <section class="pt-hero">
    <div class="pt-ctn">
      <nav class="pt-bc" aria-label="Brødkrumme">
        <a href="/">Forside</a><span>›</span>
        <a href="/fiskepladser/">Fiskepladser</a><span>›</span>
        <span>Put &amp; Take</span>
      </nav>
      <h1 class="pt-title">Put and take søer i Danmark</h1>
      <p class="pt-sub">{lakes.length} put and take søer fra Thy til Bornholm – med priser, fiskearter og regler for de søer, vi har tjekket. Find en sø i din region eller tæt på dig.</p>
    </div>
  </section>

  <section class="pt-body">
    <div class="pt-ctn">
      <div class="pt-narrow">
        <div class="answer-capsule">
          <span class="ac-label">Kort fortalt</span>
          <h2 class="ac-q">Hvad er put and take, og hvad koster det?</h2>
          <p class="ac-a">
            En put and take sø er en privat fiskesø, hvor ejeren sætter fisk ud – mest regnbueørreder – og du betaler for at fiske og tage fisken med hjem. <strong>Du skal ikke have fisketegn.</strong>
            {p2 && <> I de søer, vi har tjekket, koster <strong>2 timer {p2.min}–{p2.max} kr.</strong></>}
            {' '}Vi har registreret <strong>{lakes.length} åbne søer</strong> i Danmark.
          </p>
        </div>
      </div>

      <h2 class="pt-h2">Put and take søer region for region</h2>
      <div class="pt-regions">
        {regionCards.map((r) => (
          <a class="pt-region" href={`${BASE}/${r.slug}/`}>
            <strong>Put and take {r.name}</strong>
            <span>{r.count} søer{r.slug === 'sjaelland' ? ' (inkl. Bornholm)' : ''}</span>
          </a>
        ))}
      </div>

      <h2 class="pt-h2">Søer med priser, regler og fakta</h2>
      <div class="pt-cards">
        {pages.map((l) => (
          <a class="pt-card" href={lakeUrl(l)}>
            {l.visited && <em>Jeg har fisket her</em>}
            <strong>{lakeName(l)}</strong>
            <span>{l.town}{cheapestTicket(l) ? ` · fra ${cheapestTicket(l)}` : ''}</span>
          </a>
        ))}
      </div>

      <h2 class="pt-h2" id="alle-soeer">Alle put and take søer i Danmark</h2>
      <LakeTable lakes={lakes} showRegion={true} />

      <div class="pt-narrow">
        <GuideLink href="/fiskeguide/put-take-fiskeri/" title="Sådan fisker du put and take" desc="Min guide til grej, agn, Powerbait og spinnere – og hvordan din første tur foregår." />
        <GuideLink href="/fiskepladser/put-and-take/oersted-oerredvand/" title="Fisketur: Ørsted en kold marts dag" desc="Hvorfor fluestangen ikke virkede, og hvordan Meps Aglia str. 2 gav en ørred på 2,5 kg." />
        <GuideLink href="/blog/put-take-fiskeri-i-varmt-vejr/" title="Put and take i varmt vejr" desc="Hvornår og hvad der bider bedst, når vandet er varmt." />

        <h2 id="faq" class="faq-heading">Ofte stillede spørgsmål om put and take</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary><h3>{f.question}</h3></summary>
              <div class="faq-answer"><p set:html={f.answer} /></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>
