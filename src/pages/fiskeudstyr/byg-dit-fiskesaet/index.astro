---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getProduct, formatPrice } from '../../../lib/feed';

// ─────────────────────────────────────────────────────────────
// Sæt-byggeren: målfisk × metode × budget → fast sæt af
// stang + hjul + line + agn. Alle produkter er reelle, lagerførte
// varer fra fiskegrej.dk-feedet. Build fejler hvis et ID mangler
// eller et sæt overskrider sit budgetloft.
// ─────────────────────────────────────────────────────────────

const BUDGETS = [
  { key: 'b1', label: 'Under 750 kr.', cap: 750 },
  { key: 'b2', label: 'Maks. 1.000 kr.', cap: 1000 },
  { key: 'b3', label: 'Maks. 1.500 kr.', cap: 1500 },
  { key: 'b4', label: 'Maks. 2.000 kr.', cap: 2000 },
  { key: 'b5', label: 'Over 2.000 kr.', cap: Infinity },
] as const;

type SlotDef = { id: string; spec: string };
type SetDef = {
  rod: SlotDef; reel: SlotDef; line: SlotDef; lure: SlotDef;
  note: string;
} | null;

