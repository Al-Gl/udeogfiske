<script is:inline define:vars={{ speciesMeta }}>
  (function () {
    var root = document.getElementById('fsb');
    if (!root) return;

    var state = {
      species: speciesMeta[0].key,
      tech: speciesMeta[0].techniques[0].key,
      budget: 'b1',
    };

    var techWrap = root.querySelector('[data-step="tech"]');

    function renderTechPills() {
      var sp = speciesMeta.find(function (s) { return s.key === state.species; });
      techWrap.innerHTML = '';
      sp.techniques.forEach(function (t) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'fsb-pill' + (t.key === state.tech ? ' is-active' : '');
        btn.setAttribute('data-value', t.key);
        btn.textContent = t.label;
        techWrap.appendChild(btn);
      });
    }

    function show() {
      root.querySelectorAll('.fsb-set').forEach(function (el) { el.hidden = true; });
      var target = document.getElementById('set-' + state.species + '-' + state.tech + '-' + state.budget);
      if (target) target.hidden = false;
    }

    root.addEventListener('click', function (e) {
      var pill = e.target.closest('.fsb-pill');
      if (!pill) return;
      var step = pill.parentElement.getAttribute('data-step');
      var value = pill.getAttribute('data-value');

      if (step === 'species') {
        state.species = value;
        var sp = speciesMeta.find(function (s) { return s.key === value; });
        if (!sp.techniques.some(function (t) { return t.key === state.tech; })) {
          state.tech = sp.techniques[0].key;
        }
        renderTechPills();
      } else if (step === 'tech') {
        state.tech = value;
      } else if (step === 'budget') {
        state.budget = value;
      }

      pill.parentElement.querySelectorAll('.fsb-pill').forEach(function (p) {
        p.classList.toggle('is-active', p === pill);
      });
      show();
    });

    renderTechPills();
    show();
  })();
</script>

