        b5: { rod: rods.deadbait, reel: reels.nasci, line: lines.jbraid, lure: lures.wireLeader,
              note: 'Deadbait-sættet uden kompromiser — fletline giver direkte kontakt ved hugget, selv på lang afstand.' },
      }},
    ],
  },
];

// ── Byggetids-validering + opslag ──
function resolve(slot: SlotDef) {
  const p = getProduct(slot.id);
  if (!p) throw new Error(`byg-dit-fiskesaet: produkt ${slot.id} findes ikke i feedet`);
  if (!p.price || p.price <= 0) throw new Error(`byg-dit-fiskesaet: produkt ${slot.id} (${p.name}) har ingen pris`);
  return { ...p, spec: slot.spec };
}

const SLOT_LABELS = [
  { key: 'rod', label: 'Stang' },
  { key: 'reel', label: 'Hjul' },
  { key: 'line', label: 'Line' },
  { key: 'lure', label: 'Agn' },
] as const;

type ResolvedSet = {
  id: string;
  speciesLabel: string;
  techLabel: string;
  budgetLabel: string;
  items: { label: string; name: string; spec: string; price: number; url: string; image: string }[];
  total: number;
  note: string;
} | { id: string; empty: true; message: string };

const resolvedSets: ResolvedSet[] = [];
for (const sp of matrix) {
  for (const tech of sp.techniques) {
    for (const b of BUDGETS) {
      const def = tech.sets[b.key];
      const id = `${sp.key}-${tech.key}-${b.key}`;
      if (!def) {
        resolvedSets.push({
          id, empty: true,
          message: `Et ${tech.label.toLowerCase()}-sæt til ${sp.label.toLowerCase()} kan ikke sammensættes ærligt i denne prisklasse — grejet bliver for ringe til at jeg vil anbefale det. Vælg en højere prisklasse og se mit bud der.`,
        });
        continue;
      }
      const items = SLOT_LABELS.map(({ key, label }) => {
        const r = resolve(def[key]);
        return { label, name: r.name, spec: r.spec, price: r.price, url: r.url, image: r.image };
      });
      const total = items.reduce((s, i) => s + i.price, 0);
      if (total > b.cap) throw new Error(`byg-dit-fiskesaet: ${id} koster ${total} kr — over loftet på ${b.cap} kr`);
      resolvedSets.push({
        id,
        speciesLabel: sp.label,
        techLabel: tech.label,
        budgetLabel: b.label,
        items,
        total,
        note: def.note,
      });
    }
  }
}

// Til klient-scriptet: hvilke teknikker findes pr. art
const speciesMeta = matrix.map((sp) => ({
  key: sp.key,
  label: sp.label,
  techniques: sp.techniques.map((t) => ({ key: t.key, label: t.label })),
}));

const faqs = [
  {
    question: "Hvad består et komplet fiskesæt af?",
    answer: "Et komplet spinne- eller medesæt består af fire dele: en <strong>fiskestang</strong>, et <strong>fiskehjul</strong>, <strong>line</strong> og <strong>endegrej</strong> (blink, spinner, forfang eller agn). Til fluefiskeri hedder delene fluestang, fluehjul, flueline og flue — her skal du derudover bruge backing og et taperet forfang.",
  },
  {
    question: "Hvor meget skal et begyndersæt koste?",
    answer: "Du kan komme ærligt i gang for <strong>600–750 kr.</strong> til de fleste fiskearter. Under det niveau bliver grejet så ringe, at det ødelægger oplevelsen. Rammer du <strong>1.500 kr.</strong>, får du grej der holder i mange sæsoner — og omkring <strong>2.000 kr.</strong> begynder det at være udstyr, du aldrig vokser fra.",
  },
  {
    question: "Hvorfor kan jeg ikke få et fluesæt under 1.500 kr.?",
    answer: "Fordi det ikke findes i en kvalitet, jeg vil stå inde for. En brugbar fluestang starter omkring 1.000 kr., og dertil kommer fluehjul og flueline. Et komplet fluesæt af ærlig kvalitet starter realistisk ved <strong>1.700–2.000 kr.</strong>",
  },
  {
    question: "Skal jeg bruge nylon eller fletline?",
    answer: "<strong>Nylon</strong> er billigst, mest tilgivende og fint til begyndersæt og medefiskeri. <strong>Fletline</strong> kaster længere og giver direkte kontakt — det er standard til gedde og et klart opgraderingspunkt til kystfiskeri fra ca. 1.500 kr.-klassen. Husk altid et forfang af fluorocarbon eller wire (gedde) foran fletline.",
  },
];
