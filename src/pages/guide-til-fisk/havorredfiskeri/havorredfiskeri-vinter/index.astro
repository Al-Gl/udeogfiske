---
import MainLayout from '../../../../layouts/MainLayout.astro';
import DidYouKnow from '../../../../components/DidYouKnow.astro';
import TipBox from '../../../../components/TipBox.astro';
import StatHighlight from '../../../../components/StatHighlight.astro';
import DifficultyMeter from '../../../../components/DifficultyMeter.astro';
import Affiliate from '../../../../components/Affiliate.astro';
import GuideLink from '../../../../components/GuideLink.astro';
import RelatedRow from '../../../../components/RelatedRow.astro';

const faqs = [
  {
    question: "Kan man fange havørred om vinteren?",
    answer: "Ja, men det handler om aggression, ikke føde. I koldt vand under 6 grader jager havørreden sjældent for at spise — den hugger, når et blink provokerer den. Skarpe farver som pink og orange, en aggressiv eller uregelmæssig gang i agnet, og en langsom, dyb præsentation er det, der skaber hug i vintermånederne.",
  },
  {
    question: "Hvornår på dagen er det bedst at fiske havørred om vinteren?",
    answer: "Midt på dagen, når vandet har haft mest tid til at varme sig lidt op. Modsat sommerens tidlige morgener og sene aftener er det om vinteren de varmeste timer af dagen, der giver de bedste chancer — typisk fra sen formiddag til tidlig eftermiddag.",
  },
  {
    question: "Hvilken farve blink er bedst til havørred i koldt vand?",
    answer: "Skarpe provokationsfarver som pink og orange fungerer bedst, når vandet er koldt og havørreden er sløv. Kombinér farven med et blink, der har en aggressiv eller uregelmæssig gang — det er kombinationen af farve og bevægelse, der lokker de trætte vinterfisk til at hugge.",
  },
  {
    question: "Skal jeg genudsætte havørred, jeg fanger om vinteren?",
    answer: "Farvede gydefisk er fredet fra 16. november til 15. januar og skal altid genudsættes i den periode. Uden for fredningen bør du desuden se på fiskens kondition: tynde, udtjente \"nedfaldsfisk\" har brugt deres reserver på gydningen og bør sættes tilbage, uanset om de er over mindstemålet på 40 cm.",
  },
];

const about = [
  {
    name: "Havørred (Salmo trutta trutta)",
    sameAs: "https://da.wikipedia.org/wiki/Hav%C3%B8rred",
  },
];
---

<MainLayout
  title="Havørredfiskeri om Vinteren | Guide til Kulde-Fiskeri"
  description="Kan man fange havørred om vinteren? Læs min guide til vinterfiskeri efter havørred — hvor fisken står, hvilket agn der virker, og hvornår på dagen du skal fiske."
  canonical="https://udeogfiske.dk/guide-til-fisk/havorredfiskeri/havorredfiskeri-vinter/"
  pageType="article"
  breadcrumbs={[
    { name: "Forside", url: "/" },
    { name: "Guide til fisk", url: "/guide-til-fisk/" },
    { name: "Havørredfiskeri", url: "/guide-til-fisk/havorredfiskeri/" },
    { name: "Havørredfiskeri om Vinteren" },
  ]}
  articleData={{
    headline: "Havørredfiskeri om Vinteren – Guide til Kulde-Fiskeri",
    image: "/images/havorred_vinter_hero.jpg",
    datePublished: "2026-09-11",
  }}
  faq={faqs}
  about={about}
>

  <section class="pg-hero">
    <div class="pg-ctn">
      <nav class="pg-bc">
        <a href="/">Forside</a>
        <span>›</span>
        <a href="/guide-til-fisk/">Guide til fisk</a>
        <span>›</span>
        <a href="/guide-til-fisk/havorredfiskeri/">Havørredfiskeri</a>
        <span>›</span>
        <span>Om Vinteren</span>
      </nav>
      <h1 class="pg-title">Havørredfiskeri om Vinteren</h1>
      <p class="pg-sub">Vinterfiskeri efter havørred handler ikke om føde, men om provokation. Sådan finder du fisken, vælger agnet og timer dagen, når vandet er koldt.</p>
    </div>
  </section>

  <section class="pg-body">
    <div class="pg-ctn">

      <div class="answer-capsule">
        <span class="ac-label">Kort fortalt</span>
        <h2 class="ac-q">Kan man fange havørred om vinteren?</h2>
        <p class="ac-a"><strong>Ja — men det kræver en helt anden tilgang end resten af året.</strong> I koldt vand under 6 grader jager havørreden ikke for at spise; den hugger, når den bliver provokeret. Skarpe farver (pink, orange), et blink med aggressiv eller uregelmæssig gang, en langsom og dyb præsentation, og de varmeste timer midt på dagen er de fire ting, der oftest afgør, om du får hug.</p>
      </div>

      <article class="article">
        <p>De fleste lystfiskere lægger stangen på hylden, når temperaturen falder under frysepunktet. Det er en fejl. Havørreden forsvinder ikke om vinteren — den flytter sig, sænker tempoet og skifter motivation fra føde til aggression. Forstår du den forskel, kan du stadig få gode fisk i de koldeste måneder, hvor du har kysten og fjorden næsten for dig selv.</p>
        <p>Denne guide er en strategi-oversigt for hele vinteren (december–februar). Vil du have måned-for-måned detaljer om spots og fangster, finder du dem i de tre månedsguider til <a href="/guide-til-fisk/havorredfiskeri/havorredfiskeri-december/">december</a>, <a href="/guide-til-fisk/havorredfiskeri/havorredfiskeri-januar/">januar</a> og <a href="/guide-til-fisk/havorredfiskeri/havorredfiskeri-februar/">februar</a>.</p>
      </article>

      <figure class="art-figure">
        <img src="/images/havorred_vinter_hero.jpg" alt="Dansk fjordkyst en kold vintermorgen med frost og let dis over vandet" width="1408" height="768" loading="lazy" />
        <figcaption>En stille vintermorgen ved fjorden — koldt, stille og næsten tomt for andre fiskere.</figcaption>
      </figure>

      <DifficultyMeter value={78} label="Sværhedsgrad om vinteren" />

      <article class="article">
        <h2>Hvor står havørreden om vinteren?</h2>
        <p>Om vinteren trækker mange havørreder op i varmere fjorde og åer for at gyde. Saltindholdet er lavere der, og vandet er ofte lidt lunere end ved den åbne kyst. Andre havørreder — særligt overspringerne, der ikke skal gyde — søger i stedet ud på dybere havvand, hvor temperaturen svinger mindre end på lavt vand.</p>
        <p>Din vigtigste opgave om vinteren er derfor at vælge mellem to strategier: fisk fjorden efter varme og lavt saltindhold, eller fisk den åbne kyst efter dybde og stabilitet. Når du finder en stime i den rigtige type vand, kan vinterfiskeriet faktisk være overraskende godt — især med de rigtige farver på blink, gennemløbere eller flue.</p>
      </article>

      <DidYouKnow>
        Havørredens stofskifte er direkte styret af vandtemperaturen. Under 6 grader falder dens fordøjelse og aktivitetsniveau markant — den har simpelthen ikke brug for at jage lige så meget som om sommeren. Det er derfor et hug i januar oftere er et <em>refleks-hug</em> udløst af provokation end et bevidst forsøg på at spise.
      </DidYouKnow>

      <article class="article">
        <h2>Hvilket agn virker bedst til havørred om vinteren?</h2>
        <p>Glem de naturlige, diskrete farver, du bruger om sommeren. I koldt vand handler det om at vække en sløv fisk, ikke om at ligne en overbevisende fødeemne.</p>
      </article>

      <Affiliate
        productId="503581"
        note="Min faste vintervalg. Den skarpe pink/orange farve og den uregelmæssige gang er lige det, der skal til for at få en træg vinterfisk til at reagere — jeg fisker den langsomt og dybt, med lange spinstop."
      />

      <TipBox>
        <p><strong>Mit tip:</strong> I koldt vand under 6° handler det ikke om mad, men om aggression — en skrigende pink farve og et blink med uregelmæssig gang vækker de sløve fisk. Fisk langsomt og dybt, med lange pauser i indspinningen, og sæt altid de farvede gydefisk tilbage.</p>
      </TipBox>

      <figure class="art-figure">
        <img src="/images/havorred_vinter_grej.jpg" alt="Vinteragn til havørred — pink/orange provokationsblink på en frostbelagt træbro" width="1280" height="720" loading="lazy" />
        <figcaption>Skarpe provokationsfarver klar til en kold morgen på pladsen.</figcaption>
      </figure>

      <article class="article">
        <h2>Hvornår på dagen skal du fiske havørred om vinteren?</h2>
        <p>Modsat sommerens tidlige morgener og sene aftener er det om vinteren de varmeste timer af dagen, der giver de bedste chancer — typisk fra sen formiddag til tidlig eftermiddag. Vandet har da haft mest tid til at samle den lidt varme, solen kan give, og havørreden er en anelse mere aktiv i disse timer end i den kolde morgen eller aften.</p>
      </article>

      <StatHighlight
        icon="thermometer"
        value="Under 6 °C"
        caption="Under denne temperatur skifter havørreden fra fødesøgning til provokations-hug — nøglen til at forstå vinterfiskeriet."
      />

      <figure class="art-figure art-figure--wide">
        <img src="/images/havorred_vinter_fjord.jpg" alt="Uberørt dansk vinterkyst med rimfrost, sten og rørgræs langs en stille fjordvig" width="1584" height="672" loading="lazy" />
        <figcaption>En beskyttet fjordvig — lavere saltindhold og lidt lunere vand end den åbne kyst.</figcaption>
      </figure>

      <article class="article">
        <h2>Hvad er reglerne for havørredfiskeri om vinteren?</h2>
        <p>Farvede havørreder i gydedragt er fredet fra <strong>16. november til 15. januar</strong> og skal altid genudsættes i den periode — uanset størrelse. Det gælder de fisk, der er trukket op i fjorde og åer for at gyde.</p>
        <p>Efter fredningen bør du stadig bruge dømmekraft: <strong>nedfaldsfisk</strong> — tynde, udtjente fisk, der lige har gydt — er svage og bør sættes tilbage, selv om de teknisk set er over mindstemålet på 40 cm og uden for fredningsperioden. Giv dem chancen for at genvinde kræfterne til næste sæson.</p>

        <GuideLink
          href="/guide-til-fisk/havorredfiskeri/"
          title="Læs den fulde havørredfiskeri-guide"
          desc="Biologi, grej, fødeemner og alle 12 månedsguider samlet ét sted."
        />
      </article>

      <article class="article">
        <h2>FAQ</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary><h3>{f.question}</h3></summary>
              <div class="faq-answer">
                <p set:html={f.answer} />
              </div>
            </details>
          ))}
        </div>
      </article>

      <nav class="month-nav">
        <span class="mn-label">Vintermånederne i detaljer:</span>
        <a href="/guide-til-fisk/havorredfiskeri/havorredfiskeri-december/">December</a>
        <a href="/guide-til-fisk/havorredfiskeri/havorredfiskeri-januar/">Januar</a>
        <a href="/guide-til-fisk/havorredfiskeri/havorredfiskeri-februar/">Februar</a>
        <a href="/guide-til-fisk/havorredfiskeri/" class="mn-parent">↑ Tilbage til havørredfiskeri</a>
      </nav>

    </div>
  </section>

  <RelatedRow items={[
    {
      title: "Havørredfiskeri i December",
      description: "Vinterkulden begynder — første måned med fokus på overspringere og fjorde.",
      href: "/guide-til-fisk/havorredfiskeri/havorredfiskeri-december/",
      image: "/images/havorred_vinter_hero.jpg",
      alt: "Vinterfiskeri efter havørred",
      chip: "December",
    },
    {
      title: "Havørredfiskeri i Januar",
      description: "Fang overspringere i årets koldeste måned — pladser, agn og teknik.",
      href: "/guide-til-fisk/havorredfiskeri/havorredfiskeri-januar/",
      image: "/images/havorred_vinter_grej.jpg",
      alt: "Vinteragn til havørred",
      chip: "Januar",
    },
    {
      title: "Catch and Release",
      description: "Nedfaldsfisk og farvede gydefisk skal behandles ekstra skånsomt — lær teknikken.",
      href: "/fiskeguide/catch-and-release/",
      image: "/images/cnr_hero.png",
      alt: "Fisker der skånsomt genudsætter en fisk",
      chip: "Praksis",
    },
  ]} />

</MainLayout>

