---
// Full-screen page: only the coast explorer, with a slim floating top bar (no site header/footer).
import MainLayout from '../../../../layouts/MainLayout.astro';
import CoastExplorer from '../../../../components/CoastExplorer.astro';
---

<MainLayout
  title="Kystverden: Hvor står havørreden på kysten? | Ude og Fiske"
  description="Udforsk en dansk havørredkyst interaktivt. Zoom ind på badekarret, tangbæltet, pynten, ålegræsset og stenrevet, og se hvad havørreden lever af dér."
  canonical="https://udeogfiske.dk/guide-til-fisk/havorredfiskeri/kystverden/"
  ogImage="https://udeogfiske.dk/images/kystverden/root.webp"
  pageType="article"
  noindex={true}
  bare={true}
  breadcrumbs={[
    { name: "Forside", url: "/" },
    { name: "Guide til fisk", url: "/guide-til-fisk/" },
    { name: "Havørredfiskeri", url: "/guide-til-fisk/havorredfiskeri/" },
    { name: "Kystverden" },
  ]}
>
  <header class="kv-top">
    <a href="/" class="kv-logo" aria-label="Ude og Fiske — forside">
      <img src="/images/logo.png" alt="" width="36" height="36" />
      <span>Ude og Fiske</span>
    </a>
    <h1 class="kv-title">Kystverden</h1>
    <a href="/guide-til-fisk/havorredfiskeri/" class="kv-link">← Havørredguiden</a>
  </header>

  <CoastExplorer />
</MainLayout>

<style>
  :global(html), :global(body) { overflow: hidden; height: 100%; }

  .kv-top {
    position: fixed;
    z-index: 1200;
    top: 0.75rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    pointer-events: none;
  }
  .kv-top > * { pointer-events: auto; }

  .kv-logo, .kv-link, .kv-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem 0.4rem 0.45rem;
    border-radius: 999px;
    background: rgba(13,74,94,0.82);
    backdrop-filter: blur(6px);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .kv-logo img { width: 28px; height: 28px; border-radius: 50%; background: #fff; }
  .kv-title { margin: 0; padding: 0.55rem 1rem; font-size: 0.95rem; letter-spacing: 0.02em; }
  .kv-link { margin-left: auto; padding: 0.55rem 1rem; }
  .kv-link:hover, .kv-logo:hover { background: rgba(13,74,94,0.95); }

  @media (max-width: 600px) {
    .kv-logo span, .kv-title { display: none; }
  }
</style>
