---
import MainLayout from '../../../layouts/MainLayout.astro';

// Landing page after the confirmation link in the Brevo double opt-in mail.
// Not in the sitemap and marked noindex.

// Most-clicked pages in Search Console, last 90 days (pulled 2026-10-13).
const popular = [
  { href: "/guide-til-fisk/havorredfiskeri/konditionsfaktor-havorred/", title: "Konditionsfaktor på havørred", desc: "Regn ud, hvor god form din fisk er i." },
  { href: "/fiskepladser/koebenhavn/", title: "Fiskepladser i København", desc: "Pladserne, jeg selv bruger i og omkring byen." },
  { href: "/guide-til-fisk/makrelfiskeri/", title: "Makrelfiskeri", desc: "Sæson, grej og teknik fra mole og kyst." },
  { href: "/saesonguide/", title: "Sæsonguide", desc: "Hvad der bider hvornår, måned for måned." },
  { href: "/rens-af-orred/", title: "Rens af ørred", desc: "Sådan renser jeg fangsten, trin for trin." },
  { href: "/guide-til-fisk/sildefiskeri/", title: "Sildefiskeri", desc: "Forfang, pladser og de bedste tidspunkter." },
];
---

<MainLayout
  title="Tak for din tilmelding | Ude og Fiske"
  description="Din tilmelding til nyhedsbrevet fra Ude og Fiske er bekræftet."
  canonical="https://udeogfiske.dk/nyhedsbrev/tak/"
  pageType="website"
  noindex
>

  <section class="pg-hero">
    <div class="pg-ctn">
      <p class="tk-eyebrow">Nyhedsbrev</p>
      <h1 class="pg-title">Tak, du er tilmeldt</h1>
      <p class="pg-sub">Din e-mail er bekræftet. Du får én mail om måneden fra mig med månedens plads, hvad der bider lige nu, og ét stykke grej, jeg anbefaler.</p>
    </div>
  </section>

  <section class="pg-body">
    <div class="pg-ctn">
      <h2 class="tk-h2">Mens du venter på den første mail</h2>
      <p class="tk-lead">Her er de sider, flest læser lige nu.</p>

      <ul class="tk-grid">
        {popular.map((p) => (
          <li>
            <a class="tk-card" href={p.href}>
              <span class="tk-card-title">{p.title}</span>
              <span class="tk-card-desc">{p.desc}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="tk-foot">Du kan altid afmelde dig igen via linket nederst i hver mail.</p>
    </div>
  </section>

  <!-- Confirmed here = don't show the sign-up pop-up on this device again (same key as NewsletterPopup.astro) -->
  <script is:inline>
    try { localStorage.setItem('uof-nl', JSON.stringify({ done: true, until: 0 })); } catch (e) {}
  </script>

</MainLayout>

<style>
  .pg-hero {
    position: relative;
    background: linear-gradient(120deg, #0d4a5e 0%, #082e3b 100%);
    padding: 4rem 0 3.5rem;
  }
  .pg-ctn { max-width: 1040px; margin: 0 auto; padding: 0 1.5rem; }
  .tk-eyebrow {
    margin: 0 0 0.75rem; font-size: 0.6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em; color: #f0b24a;
  }
  .pg-title {
    font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 700; color: #ffffff;
    letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 0.875rem;
  }
  .pg-sub {
    font-size: 1.0625rem; font-weight: 300; color: rgba(255,255,255,0.85);
    line-height: 1.65; max-width: 580px;
  }
  .pg-body { padding: 3.5rem 0 5rem; }

  .tk-h2 {
    font-size: 1.5rem; font-weight: 700; color: #111827;
    letter-spacing: -0.02em; line-height: 1.25; margin: 0 0 0.5rem;
  }
  .tk-lead { font-size: 1rem; color: #4b5563; line-height: 1.7; margin: 0 0 1.75rem; }

  .tk-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
  }
  .tk-card {
    display: block; height: 100%; box-sizing: border-box; padding: 1.25rem 1.25rem 1.125rem;
    background: #ffffff; border: 1px solid #e5e7eb; border-top: 3px solid #0d4a5e; border-radius: 12px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .tk-card:hover { border-top-color: #c47d0a; box-shadow: 0 10px 28px -16px rgba(13, 74, 94, 0.45); }
  .tk-card-title { display: block; font-size: 1.0625rem; font-weight: 700; color: #111827; line-height: 1.3; margin-bottom: 0.375rem; }
  .tk-card-desc { display: block; font-size: 0.9375rem; color: #4b5563; line-height: 1.55; }

  .tk-foot { margin: 2rem 0 0; font-size: 0.875rem; color: #6b7280; line-height: 1.6; }

  @media (max-width: 860px) { .tk-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .tk-grid { grid-template-columns: 1fr; } }
</style>
